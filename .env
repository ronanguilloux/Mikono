# Consumed once by frankenphp/docker-entrypoint.sh on first `docker compose up`
# to select the Symfony version for the initial `composer create-project`.
# See docs/adr/0003-adopt-docker-frankenphp-symfony-sqlite-tailwind-for-volunteer-manager.md
SYMFONY_VERSION=8.1.*
STABILITY=stable

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
# In production this is overridden by the deploy env file with the real
# domain — see docs/project/deployment-plan.md.
DEFAULT_URI=https://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# SQLite per docs/adr/0003-...md — one file per environment (dev/test
# never share data), inside var/data/ so it lands in the db_data named
# volume declared in compose.yaml when running under Docker (Docker's
# own DATABASE_URL env var there takes precedence over this file, but
# this is what a host-run `bin/console` or an IDE would use directly).
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/data_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###
