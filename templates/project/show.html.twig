{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} — UCESCO Volunteer Manager{% endblock %}

{% block body %}
    <a href="{{ path('project_index') }}" class="mb-4 inline-block text-sm text-slate-600 hover:underline">← Back to Projects</a>

    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="flex flex-wrap items-center gap-2 text-xl font-semibold">
                {{ project.name }}
                <twig:Pill :tone="project.active ? 'brand' : 'neutral'">{{ project.active ? 'Active' : 'Inactive' }}</twig:Pill>
            </h1>
            <p class="mt-1 text-sm text-slate-500">
                {% if project.branch %}<a href="{{ path('branch_show', {id: project.branch.id}) }}" class="text-brand-600 hover:underline">{{ project.branch.name }}</a> · {% endif %}
                {{ project.ownership ? project.ownership.label : 'Ownership not set' }}{% if project.partnerOrganizationName %} — {{ project.partnerOrganizationName }}{% endif %}
            </p>
        </div>
        <div class="flex gap-2">
            <a href="{{ path('project_edit', {id: project.id}) }}"
               class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                Edit
            </a>
            <a href="{{ path('activity_new', {project: project.id}) }}"
               class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">
                Assign volunteers
            </a>
        </div>
    </div>

    <div class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        <section aria-labelledby="months-heading" data-project-months>
            <h2 id="months-heading" class="mb-3 font-semibold">Volunteers here per month</h2>
            {% set current = months|last %}
            <twig:ColumnChart
                :title="(months|first).month|date('M Y') ~ ' – ' ~ current.month|date('M Y')"
                :summary="'This month: ' ~ current.volunteers ~ ' volunteer' ~ (current.volunteers == 1 ? '' : 's')"
                :columns="months|map(m => {label: m.month|date('M'), title: m.month|date('F Y'), value: m.volunteers})"
            />
        </section>

        {% if project.description %}
            <section aria-labelledby="description-heading">
                <h2 id="description-heading" class="mb-3 font-semibold">Description</h2>
                <p class="whitespace-pre-line rounded-lg border border-slate-200 bg-white p-4 text-sm shadow-sm">{{ project.description }}</p>
            </section>
        {% endif %}
    </div>

    <section class="mb-10" aria-labelledby="programs-heading" data-project-programs>
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="programs-heading" class="font-semibold">Programs</h2>
            <a href="{{ path('program_index', {project: project.id}) }}" class="text-sm text-brand-600 hover:underline">Open in Programs, to filter or export →</a>
        </div>
        <twig:DataTable
            :columns="programColumns"
            :rows="programRows"
            :pagination="programPagination"
            :sortState="programSortState"
            :withActions="false"
            emptyMessage="No program at this project yet — activities are logged against one."
        />
    </section>

    <section class="mb-10" aria-labelledby="activities-heading" data-project-activities>
        <h2 id="activities-heading" class="mb-3 font-semibold">Activities</h2>
        <twig:DataTable
            :columns="activityColumns"
            :rows="activityRows"
            :pagination="activityPagination"
            :sortState="activitySortState"
            :withActions="false"
            emptyMessage="Nothing logged at this project yet."
        />
    </section>

    <section aria-labelledby="achievements-heading" data-project-achievements>
        <h2 id="achievements-heading" class="mb-3 font-semibold">Achievements</h2>
        <twig:DataTable
            :columns="achievementColumns"
            :rows="achievementRows"
            :pagination="achievementPagination"
            :sortState="achievementSortState"
            :withActions="false"
            emptyMessage="No achievement recorded here yet."
        />
    </section>
{% endblock %}
