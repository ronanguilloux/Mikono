{% extends 'base.html.twig' %}

{% block title %}Projects — UCESCO Volunteer Manager{% endblock %}

{% block body %}
    <div class="mb-4 flex items-center justify-between">
        <h1 class="text-xl font-semibold">Projects</h1>
        <a
            href="{{ path('project_new') }}"
            class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"
        >
            Add project
        </a>
    </div>

    <twig:DataTable :columns="columns" :rows="rows" :pagination="pagination" :sortState="sortState" emptyMessage="No projects yet — add the first one above." />
{% endblock %}
