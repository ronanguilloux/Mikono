{#
    A waffle: one square per unit of value (one activity, one day), coloured
    by category in row order, with ChartLegend below. Reads as a count you can
    tally, not just a share. `rows` is a list of {label, value},
    largest first. Plain HTML and CSS (ADR 0048).
#}
{% props title, summary, rows %}
<figure {{ attributes.defaults({class: 'rounded-lg border border-slate-200 bg-white p-4 shadow-sm'}) }}>
    <figcaption class="mb-3 flex flex-wrap items-baseline justify-between gap-x-3">
        <span class="font-medium text-slate-800">{{ title }}</span>
        <span class="text-sm text-slate-500">{{ summary }}</span>
    </figcaption>
    <div class="flex flex-wrap gap-[2px]" aria-hidden="true">
        {% for r in rows %}
            {% set squares = r.value %}
            {% if squares > 0 %}
                {% for i in 1..squares %}
                    <span class="size-3 rounded-sm" style="background-color: {{ chart_palette[loop.parent.loop.index0] }}" title="{{ r.label }}: {{ r.value|number_format }}"></span>
                {% endfor %}
            {% endif %}
        {% endfor %}
    </div>
    <twig:ChartLegend :rows="rows" class="mt-3 space-y-1 text-sm" />
</figure>
