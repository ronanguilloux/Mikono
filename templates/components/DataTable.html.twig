{#
    Every param except the three the header link sets itself, so a sort keeps
    `perPage` and the Reports `tab`. `page` is dropped deliberately: a new sort
    order means a new page 1, and keeping the old offset would drop the reader
    somewhere arbitrary. Same idiom as the Reports tab nav and PaginationBar's
    page-size form.
#}
{% set sort_carried = app.request.query.all|filter((v, k) => k not in ['sort', 'direction', 'page'] and v is not iterable) %}

<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
            <tr>
                {% for column in columns %}
                    {% if sortState is not null and sortState.isSortable(column.key) %}
                        <th
                            class="px-4 py-2 text-left font-medium text-slate-600"
                            {% if sortState.ariaSortFor(column.key) %}aria-sort="{{ sortState.ariaSortFor(column.key) }}"{% endif %}
                        >
                            {#
                                The link text is the bare column label, with the
                                arrow as a sibling outside the <a>: several tests
                                resolve headers and buttons by text, and "Name ↑"
                                would break them.
                            #}
                            <a
                                href="{{ path(app.request.attributes.get('_route'), sort_carried|merge({
                                    sort: column.key,
                                    direction: sortState.nextDirectionFor(column.key),
                                })) }}"
                                class="hover:text-brand-700 hover:underline"
                                data-sort-link="{{ column.key }}"
                            >{{ column.label }}</a>
                            {% if sortState.isActive(column.key) %}
                                <span class="ml-0.5 text-brand-600" aria-hidden="true">{{ sortState.direction == 'asc' ? '↑' : '↓' }}</span>
                            {% endif %}
                        </th>
                    {% else %}
                        <th class="px-4 py-2 text-left font-medium text-slate-600">{{ column.label }}</th>
                    {% endif %}
                {% endfor %}
                {% if withActions %}
                    <th class="px-4 py-2"></th>
                {% endif %}
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            {% for row in rows %}
                <tr>
                    {% for column in columns %}
                        {#
                            The badge is a sibling of the cell text, not part of
                            it: the row's `cells` stay the plain formatted value
                            so sorting and the print panel are unaffected, and
                            tests that match a cell by its text still do. The
                            print variants are there because browsers drop
                            background colours on paper by default — without a
                            border the pill would vanish from the print panel.
                        #}
                        <td class="px-4 py-2 align-top">
                            {{- row.cells[column.key]|default('') -}}
                            {%- if row.badges[column.key] is defined %}
                                <span class="ml-1.5 whitespace-nowrap rounded-full bg-brand-100 px-2 py-0.5 text-xs font-medium text-brand-700 print:border print:border-slate-400 print:text-slate-700">{{ row.badges[column.key] }}</span>
                            {%- endif -%}
                        </td>
                    {% endfor %}
                    {% if withActions %}
                        <td class="px-4 py-2 text-right align-top whitespace-nowrap">
                            <twig:RowActions :actions="row.actions|default([])" />
                        </td>
                    {% endif %}
                </tr>
            {% else %}
                <tr>
                    <td colspan="{{ columns|length + (withActions ? 1 : 0) }}" class="px-4 py-6 text-center text-slate-500">
                        {{ emptyMessage }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{#
    Outside the table and outside the scroll wrapper, deliberately: several
    tests count `table tbody tr`, and page links inside <table> would both
    break those and be invalid markup.
#}
{% if pagination is not null %}
    <twig:PaginationBar :pagination="pagination" />
{% endif %}
