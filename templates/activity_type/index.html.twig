{% extends 'base.html.twig' %}

{% block title %}Activity Types — UCESCO Volunteer Manager{% endblock %}

{% block body %}
    <div class="mb-4 flex items-center justify-between">
        <h1 class="text-xl font-semibold">Activity Types</h1>
        <a
            href="{{ path('activity_type_new') }}"
            class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800"
        >
            Add activity type
        </a>
    </div>

    <twig:DataTable :columns="columns" :rows="rows" emptyMessage="No activity types yet — add the first one above." />
{% endblock %}
