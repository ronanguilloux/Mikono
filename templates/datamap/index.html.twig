  source:{name:"Source",tag:"a shared list",what:"Where a volunteer heard of UCESCO: unique name and description. One list for the whole organisation, created with the application and editable by staff.",links:["held by volunteers (several per volunteer)"],rules:["Recorded once per volunteer, not per stay.","In the reports, “By source” counts volunteers per channel."],del:"Refused if a volunteer came through it."},
  groupe:{name:"Beneficiary group",tag:"who a program serves",what:"Unique name and description. Starts empty: the Volunteer Manager builds the list.",links:["tags programs (several per program)"],rules:["In the reports, “By group” credits an activity to every group of its program."],del:"Refused if a program is tagged with it."},
  indicator:{name:"Indicator",tag:"what an achievement counts",what:"Unique name and description, such as \u201cchildren reached\u201d. Starts empty: the Volunteer Manager builds the list.",links:["used by achievements (0 or 1 per achievement)"],rules:["An achievement's indicator and its number come together, or not at all.","Impact counts live on achievements, never on activities, which would multiply them."],del:"Refused if an achievement uses it."}
};
const svg=document.getElementById('map'), detail=document.getElementById('detail');
const esc=s=>s.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
function pick(id){
  document.querySelectorAll('.chip').forEach(c=>c.setAttribute('aria-pressed',String(c.dataset.pick===id)));
  svg.querySelectorAll('.on,.sel').forEach(e=>e.classList.remove('on','sel'));
  if(!D[id]){svg.classList.remove('focusing');detail.hidden=true;return;}
  svg.classList.add('focusing');
  const me=svg.querySelector(`.ent[data-id="${id}"]`); me.classList.add('on','sel');
  svg.querySelectorAll('.edge').forEach(e=>{
    if(e.dataset.a===id||e.dataset.b===id){e.classList.add('on');
      [e.dataset.a,e.dataset.b].forEach(n=>svg.querySelector(`.ent[data-id="${n}"]`).classList.add('on'));}
  });
  const d=D[id]; detail.hidden=false;
  detail.innerHTML=`<header><span class="eyebrow">${esc(d.tag)}</span><h3 style="font-size:1.5rem">${esc(d.name)}</h3></header>
  <dl><div><dt>What it contains</dt><dd>${esc(d.what)}</dd></div><div><dt>Connected to</dt><dd><ul>${d.links.map(l=>`<li>${esc(l)}</li>`).join('')}</ul></dd></div></dl>
  <dl><div><dt>Rules</dt><dd><ul>${d.rules.map(l=>`<li>${esc(l)}</li>`).join('')}</ul></dd></div><div><dt>Deleting</dt><dd>${esc(d.del)}</dd></div></dl>`;
}
document.querySelectorAll('.chip').forEach(c=>c.addEventListener('click',()=>pick(c.dataset.pick)));
svg.querySelectorAll('.ent').forEach(g=>{
  g.addEventListener('click',()=>pick(g.dataset.id));
  g.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();pick(g.dataset.id);}});
});
pick('activite');
}
</script>
