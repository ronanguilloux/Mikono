<div data-controller="clipboard">
    <label for="{{ id }}" class="block text-sm font-medium text-slate-700">{{ label }}</label>
    <div class="mt-1 flex gap-2">
        <input id="{{ id }}" type="text" readonly value="{{ value }}" data-clipboard-target="source"
               class="min-w-0 flex-1 rounded-md border border-slate-300 bg-slate-50 px-3 py-2 font-mono text-sm">
        <button type="button" data-action="clipboard#copy"
                class="rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
            <span data-clipboard-target="label">Copy</span>
        </button>
    </div>
    <p class="mt-1 text-xs text-slate-500" data-clipboard-target="status" role="status"></p>
</div>
