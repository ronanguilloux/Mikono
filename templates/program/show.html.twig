{% extends 'base.html.twig' %}

{% block title %}{{ program.name }} — UCESCO Volunteer Manager{% endblock %}

{% block body %}
    <a href="{{ path('program_index') }}" class="mb-4 inline-block text-sm text-slate-600 hover:underline">← Back to Programs</a>

    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="flex flex-wrap items-center gap-2 text-xl font-semibold">
                {{ program.name }}
                <twig:Pill :tone="{Current: 'brand', 'Always on': 'brand', Upcoming: 'accent'}[period] ?? 'neutral'">{{ period }}</twig:Pill>
            </h1>
            <p class="mt-1 text-sm text-slate-500">
                <a href="{{ path('project_show', {id: program.project.id}) }}" class="text-brand-600 hover:underline">{{ program.project.name }}</a>
                {% if program.project.branch %} · <a href="{{ path('branch_show', {id: program.project.branch.id}) }}" class="text-brand-600 hover:underline">{{ program.project.branch.name }}</a>{% endif %}
                {% if dates != period %} · {{ dates }}{% endif %}
            </p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="{{ path('program_edit', {id: program.id}) }}"
               class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                Edit
            </a>
            <a href="{{ path('match_index', {program: program.id}) }}"
               class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                Find matches
            </a>
            <a href="{{ path('activity_new', {program: program.id}) }}"
               class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">
                Assign volunteers
            </a>
        </div>
    </div>

    <dl class="mb-6 grid grid-cols-2 gap-4 sm:grid-cols-4" data-program-totals>
        {% for label, value in {
            'Activities': totals.activities|number_format,
            'Volunteers engaged': totals.volunteers|number_format,
            'Total days': totals.days|number_format(1),
            'Last activity': totals.last ? totals.last|date('j M Y') : 'Never',
        } %}
            <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ label }}</dt>
                <dd class="mt-1 text-lg font-semibold">
                    {{ value }}
                    {% if label == 'Last activity' and totals.last and totals.last > today %}<twig:Pill tone="brand">Planned</twig:Pill>{% endif %}
                </dd>
            </div>
        {% endfor %}
    </dl>

    <dl class="mb-6 grid grid-cols-1 gap-4 rounded-lg border border-slate-200 bg-white p-4 sm:grid-cols-2" data-program-facts>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Booked from today</dt>
            <dd class="mt-1 text-sm">
                {{ booked }} volunteer{{ booked == 1 ? '' : 's' }}{% if program.volunteersNeeded is not null %} of {{ program.volunteersNeeded }} needed{% endif %}
            </dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Activity types</dt>
            <dd class="mt-1 text-sm">{{ program.activityTypes|map(t => t.name)|join(', ') ?: '—' }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Recommended skills</dt>
            <dd class="mt-1 text-sm">{{ program.skills|map(s => s.name)|join(', ') ?: '—' }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Beneficiary groups</dt>
            <dd class="mt-1 text-sm">{{ program.beneficiaryGroups|map(g => g.name)|join(', ') ?: '—' }}</dd>
        </div>
        {% if program.suggestedRoles %}
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Suggested roles</dt>
                <dd class="mt-1 whitespace-pre-line text-sm">{{ program.suggestedRoles }}</dd>
            </div>
        {% endif %}
        {% if program.beneficiariesReached %}
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Beneficiaries reached</dt>
                <dd class="mt-1 whitespace-pre-line text-sm">{{ program.beneficiariesReached }}</dd>
            </div>
        {% endif %}
    </dl>

    <div class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        <section aria-labelledby="months-heading" data-program-months>
            <h2 id="months-heading" class="mb-3 font-semibold">Volunteers per month</h2>
            {% set current = months|last %}
            <twig:ColumnChart
                :title="(months|first).month|date('M Y') ~ ' – ' ~ current.month|date('M Y')"
                :summary="'This month: ' ~ current.volunteers ~ ' volunteer' ~ (current.volunteers == 1 ? '' : 's')"
                :columns="months|map(m => {label: m.month|date('M'), title: m.month|date('F Y'), value: m.volunteers})"
            />
        </section>

        <section aria-labelledby="types-heading" data-program-types>
            <h2 id="types-heading" class="mb-3 font-semibold">By activity type</h2>
            <twig:DataTable
                :columns="typeColumns"
                :rows="typeRows"
                :withActions="false"
                emptyMessage="Nothing logged yet."
            />
        </section>
    </div>

    <section class="mb-10" aria-labelledby="volunteers-heading" data-program-volunteers>
        <h2 id="volunteers-heading" class="mb-3 font-semibold">Volunteers</h2>
        <twig:DataTable
            :columns="volunteerColumns"
            :rows="volunteerRows"
            :pagination="volunteerPagination"
            :sortState="volunteerSortState"
            :withActions="false"
            emptyMessage="Nobody has worked on this program yet."
        />
    </section>

    <section aria-labelledby="activities-heading" data-program-activities>
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="activities-heading" class="font-semibold">Activities</h2>
            <a href="{{ path('activity_index', {program: program.id}) }}" class="text-sm text-brand-600 hover:underline">Open in Activities, to filter or export →</a>
        </div>
        <twig:DataTable
            :columns="activityColumns"
            :rows="activityRows"
            :pagination="activityPagination"
            :sortState="activitySortState"
            :withActions="false"
            emptyMessage="Nothing logged for this program yet."
        />
    </section>
{% endblock %}
