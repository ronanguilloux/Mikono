{% use 'form_div_layout.html.twig' %}

{# `row_attr` is honoured so a field can carry Stimulus targets without the
   template having to render every row by hand — see ProjectFormType. #}
{#
   A field picking from a Settings list (`manage_route`, see
   ManageLinkTypeExtension) gets a "⚙ Manage" link on its label line. It sits
   beside the <label>, never inside it, so the label still focuses the field
   and keeps its accessible name. New tab, so nothing typed is lost; the
   manage-link controller refreshes this field's options on the way back.
#}
{% block form_row %}
    {% set row_attr = row_attr|merge({class: (row_attr.class|default('') ~ ' mb-4')|trim}) %}
    {% if manage_route ?? null %}
        {% set row_attr = row_attr|merge({
            'data-controller': (row_attr['data-controller']|default('') ~ ' manage-link')|trim,
            'data-manage-link-field-value': id,
        }) %}
    {% endif %}
    <div {% with { attr: row_attr } %}{{ block('attributes') }}{% endwith %}>
        {% if manage_route ?? null %}
            <div class="mb-1 flex items-baseline justify-between gap-2">
                {{ form_label(form, null, {label_attr: {class: 'block text-sm font-medium text-slate-700'}}) }}
                <a href="{{ path(manage_route) }}" target="_blank" rel="noopener"
                   class="shrink-0 whitespace-nowrap text-xs text-slate-500 hover:text-brand-600 hover:underline"
                   title="Manage {{ manage_label }} (opens in a new tab)"
                   data-manage-link
                   data-action="manage-link#opened"
                ><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mr-1 inline-block h-3.5 w-3.5 align-[-2px]" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>Manage<span class="sr-only">&nbsp;{{ manage_label }} (opens in a new tab)</span></a>
            </div>
        {% else %}
            {{ form_label(form) }}
        {% endif %}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
        {% if help is not empty %}
            <p class="mt-1 text-xs text-slate-500">{{ help }}</p>
        {% endif %}
    </div>
{% endblock %}

{#
    Two things this fixes that the earlier version got wrong, both of which
    only became visible once Escort turned into five expanded checkboxes:

    - It sets `for`, which the base theme sets and this override had dropped.
      Every label in the app was unassociated: not clickable, and announced by
      nothing. Compound fields (the expanded Duration/Escort groups) label a
      container rather than an input, so they still get none.
    - The class is a *default* the caller can replace, not a second `class`
      attribute after the caller's. The old markup emitted two and relied on
      browsers honouring the first — which worked, but silently, and made
      `block` unremovable for the choice children that must sit inline.
#}
{% block form_label %}
    {% if label is not same as(false) %}
        {% set label_attr = label_attr|merge({
            class: label_attr.class|default('mb-1 block text-sm font-medium text-slate-700'),
        }) %}
        {% if not (compound is defined and compound) %}
            {% set label_attr = label_attr|merge({for: id}) %}
        {% endif %}
        <label {% with { attr: label_attr } %}{{ block('attributes') }}{% endwith %}>
            {{- block('form_label_content') -}}
        </label>
    {% endif %}
{% endblock %}

{% block form_label_content %}
    {{- parent() -}}
    {%- if required and 'radio' not in block_prefixes and 'checkbox' not in block_prefixes %} <span class="text-red-600" aria-hidden="true">*</span>{% endif -%}
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="mt-1 space-y-0.5 text-xs text-red-700">
            {% for error in errors %}
                <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}

{% block form_widget_simple %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-1')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block textarea_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-1')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block choice_widget_collapsed %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-1')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block checkbox_row %}
    <div class="mb-4 flex items-center gap-2">
        {{ form_widget(form) }}
        {{ form_label(form, null, {label_attr: {class: 'text-sm font-medium text-slate-700'}}) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{#
    Expanded choices — Duration's radios, Escort's checkboxes — as inline
    pairs that wrap, rather than one stacked row per option. Each input and
    its label share a flex item so a wrap never splits them apart.
#}
{% block choice_widget_expanded %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' flex flex-wrap gap-x-5 gap-y-2')|trim}) %}
    <div {{ block('widget_container_attributes') }}>
        {%- for child in form %}
            <div class="flex items-center gap-2">
                {{- form_widget(child) -}}
                {{- form_label(child, null, {
                    translation_domain: choice_translation_domain,
                    label_attr: {class: 'text-sm text-slate-700'},
                }) -}}
            </div>
        {% endfor -%}
    </div>
{% endblock %}

{% block radio_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' h-4 w-4 border-slate-300')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block checkbox_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' h-4 w-4 rounded border-slate-300')|trim}) %}
    {{ parent() }}
{% endblock %}

{#
    A password field carries a Show/Hide toggle. The visible word changes and
    `aria-pressed` follows it; the sr-only suffix is what makes the accessible
    name "Show password" rather than a bare "Show".

    JavaScript off leaves an inert button and a normal password field — no
    behaviour depends on it.
#}
{% block password_widget %}
    {% set type = type|default('password') %}
    {% set attr = attr|merge({
        class: (attr.class|default('') ~ ' pr-16')|trim,
        'data-password-toggle-target': 'input',
    }) %}
    <div class="relative" data-controller="password-toggle">
        {{ block('form_widget_simple') }}
        <button type="button"
                class="absolute inset-y-0 right-0 flex items-center px-3 text-xs font-medium text-slate-500 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-1"
                data-action="password-toggle#toggle"
                aria-pressed="false"
        ><span data-password-toggle-target="label">Show</span><span class="sr-only">&nbsp;password</span></button>
    </div>
{% endblock %}
