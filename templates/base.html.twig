<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}UCESCO Volunteers Manager App{% endblock %}</title>
        <link rel="icon" type="image/svg+xml" href="/brand/ucesco-mark.svg">
        <link rel="alternate icon" href="/favicon.ico">
        <link rel="apple-touch-icon" href="/brand/ucesco-mark.svg">
        <meta name="theme-color" content="#00aed9">

        <meta name="description" content="UCESCO Volunteers Manager App" />
        <link rel="author" href="https://github.com/ronanguilloux" />
        <meta name="developer-url" content="https://github.com/ronanguilloux" />
        <meta name="author" content="Ronan Guilloux" />
        <meta name="creator" content="Ronan Guilloux" />
        <meta name="developer" content="Ronan Guilloux" />
        <meta name="publisher" content="UCESCO Africa" />
        <meta name="robots" content="noindex, nofollow" />
        <meta name="googlebot" content="noindex" />

        {#
            Keeps the reader's place when a sort, page, filter, tab or range
            control re-renders this page. Turbo applies it only to a same-path
            `replace` visit, which those controls ask for with
            data-turbo-action="replace" (ADR 0040). Turbo 8 also makes a POST
            redirected back to the same URL a `replace`, so a response carrying
            a flash says `reset`: the message is at the top of <main>, and a
            blocked delete's error must not land off-screen. Read once here
            because app.flashes empties the bag — the loop below reuses it.
        #}
        {% set flashes = app.flashes %}
        <meta name="turbo-refresh-scroll" content="{{ flashes is empty ? 'preserve' : 'reset' }}">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen bg-slate-50 text-slate-900">
        {% if app.user %}
            {% set nav_items = [
                {label: 'Activities', route: 'activity_index'},
                {label: 'Volunteers', route: 'volunteer_index'},
                {label: 'Achievements', route: 'achievement_index'},
                {label: 'Reports', route: 'report_index'},
            ] %}
            {% set menu_groups = [{label: 'Settings', items: [
                {label: 'Branches', route: 'branch_index'},
                {label: 'Projects', route: 'project_index'},
                {label: 'Programs', route: 'program_index'},
                {label: 'Activity Types', route: 'activity_type_index'},
                {label: 'Skills', route: 'skill_index'},
                {label: 'Beneficiary Groups', route: 'beneficiary_group_index'},
                {label: 'Escorts', route: 'escort_index'},
            ]}] %}
            {% if is_granted('ROLE_ADMIN') %}
                {% set menu_groups = menu_groups|merge([{label: 'Admin', items: [
                    {label: 'Users', route: 'user_index'},
                    {label: 'Usage', route: 'usage_index'},
                    {label: 'Data map', route: 'datamap_index'},
                    {label: 'Export database', route: 'database_export', download: true},
                ]}]) %}
            {% endif %}
            {% set current_route = app.request.attributes.get('_route') %}
            <header class="bg-brand-900 text-white print:hidden" data-controller="nav">
                <div class="mx-auto max-w-5xl px-4">
                    <div class="flex h-14 items-center justify-between">
                        <a href="{{ path('app_home') }}" class="flex items-center gap-2 font-semibold">
                            <img src="/brand/ucesco-mark-white.svg" alt="" class="h-8 w-8" aria-hidden="true">
                            UCESCO Volunteers Manager App
                        </a>

                        <div class="hidden items-center gap-4 text-sm sm:flex">
                            {% for item in nav_items %}
                                <a href="{{ path(item.route) }}" {% if item.route == current_route %}aria-current="page" {% endif %}class="hover:text-brand-300 hover:underline">{{ item.label }}</a>
                            {% endfor %}
                            {% for group in menu_groups %}
                                <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#close keydown.esc@window->dropdown#close">
                                    <button type="button" class="flex items-center gap-1 hover:text-brand-300 hover:underline" aria-expanded="false" data-dropdown-target="button" data-action="dropdown#toggle">
                                        {{ group.label }}
                                        <span aria-hidden="true">▾</span>
                                    </button>
                                    <div class="absolute right-0 z-10 mt-2 hidden w-44 rounded-md bg-white py-1 text-slate-900 shadow-lg" data-dropdown-target="menu">
                                        {% for item in group.items %}
                                            <a href="{{ path(item.route) }}" {% if item.route == current_route %}aria-current="page" {% endif %}{% if item.download is defined %}data-turbo="false" {% endif %}class="block px-4 py-2 hover:bg-slate-100">{{ item.label }}</a>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endfor %}
                            <span class="text-slate-400">|</span>
                            <span class="text-slate-300">{{ app.user.fullName }}</span>
                            <a href="{{ path('app_logout') }}" class="hover:text-brand-300 hover:underline">Sign out</a>
                        </div>

                        <button type="button" class="rounded p-2 hover:bg-brand-800 sm:hidden" aria-expanded="false" data-nav-target="menuButton" data-action="nav#toggle" aria-label="Toggle menu">
                            ☰
                        </button>
                    </div>

                    <div class="hidden pb-3" data-nav-target="menu">
                        <div class="flex flex-col gap-2 text-sm">
                            {% for item in nav_items %}
                                <a href="{{ path(item.route) }}" {% if item.route == current_route %}aria-current="page" {% endif %}class="hover:text-brand-300 hover:underline">{{ item.label }}</a>
                            {% endfor %}
                            {% for group in menu_groups %}
                                <span class="mt-1 border-t border-brand-800 pt-2 text-xs font-semibold uppercase tracking-wide text-slate-400">{{ group.label }}</span>
                                {% for item in group.items %}
                                    <a href="{{ path(item.route) }}" {% if item.route == current_route %}aria-current="page" {% endif %}{% if item.download is defined %}data-turbo="false" {% endif %}class="pl-2 hover:text-brand-300 hover:underline">{{ item.label }}</a>
                                {% endfor %}
                            {% endfor %}
                            <span class="text-slate-300">{{ app.user.fullName }}</span>
                            <a href="{{ path('app_logout') }}" class="hover:text-brand-300 hover:underline">Sign out</a>
                        </div>
                    </div>
                </div>
            </header>
        {% endif %}

        <main class="mx-auto max-w-5xl px-4 py-6">
            {% set flash_styles = {
                error: 'bg-red-50 text-red-700',
                warning: 'bg-amber-50 text-amber-800',
                success: 'bg-green-50 text-green-700',
            } %}
            {% for label, messages in flashes %}
                {% for message in messages %}
                    <div class="mb-4 rounded-md p-3 text-sm {{ flash_styles[label]|default(flash_styles.success) }}" role="alert" aria-live="polite">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
