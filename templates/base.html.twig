<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}UCESCO Volunteers Manager App{% endblock %}</title>
        <link rel="icon" type="image/svg+xml" href="/brand/ucesco-mark.svg">
        <link rel="alternate icon" href="/favicon.ico">
        <link rel="apple-touch-icon" href="/brand/ucesco-mark.svg">
        <meta name="theme-color" content="#00aed9">

        <meta name="description" content="UCESCO Volunteers Manager App" />
        <link rel="author" href="https://github.com/ronanguilloux" />
        <meta name="developer-url" content="https://github.com/ronanguilloux" />
        <meta name="author" content="Ronan Guilloux" />
        <meta name="creator" content="Ronan Guilloux" />
        <meta name="developer" content="Ronan Guilloux" />
        <meta name="publisher" content="UCESCO Africa" />
        <meta name="robots" content="noindex, nofollow" />
        <meta name="googlebot" content="noindex" />

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen bg-slate-50 text-slate-900">
        {% if app.user %}
            {% set nav_items = [
                {label: 'Activities', route: 'activity_index'},
                {label: 'Volunteers', route: 'volunteer_index'},
                {label: 'Reports', route: 'report_index'},
            ] %}
            {% set settings_items = [
                {label: 'Projects', route: 'project_index'},
                {label: 'Activity Types', route: 'activity_type_index'},
            ] %}
            {% if is_granted('ROLE_ADMIN') %}
                {% set settings_items = settings_items|merge([{label: 'Users', route: 'user_index'}]) %}
            {% endif %}
            {% set current_route = app.request.attributes.get('_route') %}
            <header class="bg-brand-900 text-white" data-controller="nav" data-action="click@window->nav#closeSettings keydown.esc@window->nav#closeSettings">
                <div class="mx-auto max-w-5xl px-4">
                    <div class="flex h-14 items-center justify-between">
                        <a href="{{ path('app_home') }}" class="flex items-center gap-2 font-semibold">
                            <img src="/brand/ucesco-mark-white.svg" alt="" class="h-8 w-8" aria-hidden="true">
                            UCESCO Volunteers Manager App
                        </a>

                        <div class="hidden items-center gap-4 text-sm sm:flex">
                            {% for item in nav_items %}
                                <a href="{{ path(item.route) }}" {% if item.route == current_route %}aria-current="page" {% endif %}class="hover:text-brand-300 hover:underline">{{ item.label }}</a>
                            {% endfor %}
                            <div class="relative">
                                <button type="button" class="flex items-center gap-1 hover:text-brand-300 hover:underline" aria-expanded="false" data-nav-target="settingsButton" data-action="nav#toggleSettings">
                                    Settings
                                    <span aria-hidden="true">▾</span>
                                </button>
                                <div class="absolute right-0 z-10 mt-2 hidden w-44 rounded-md bg-white py-1 text-slate-900 shadow-lg" data-nav-target="settingsMenu">
                                    {% for item in settings_items %}
                                        <a href="{{ path(item.route) }}" {% if item.route == current_route %}aria-current="page" {% endif %}class="block px-4 py-2 hover:bg-slate-100">{{ item.label }}</a>
                                    {% endfor %}
                                </div>
                            </div>
                            <span class="text-slate-400">|</span>
                            <span class="text-slate-300">{{ app.user.fullName }}</span>
                            <a href="{{ path('app_logout') }}" class="hover:text-brand-300 hover:underline">Sign out</a>
                        </div>

                        <button type="button" class="rounded p-2 hover:bg-brand-800 sm:hidden" aria-expanded="false" data-nav-target="menuButton" data-action="nav#toggle" aria-label="Toggle menu">
                            ☰
                        </button>
                    </div>

                    <div class="hidden pb-3" data-nav-target="menu">
                        <div class="flex flex-col gap-2 text-sm">
                            {% for item in nav_items %}
                                <a href="{{ path(item.route) }}" {% if item.route == current_route %}aria-current="page" {% endif %}class="hover:text-brand-300 hover:underline">{{ item.label }}</a>
                            {% endfor %}
                            <span class="mt-1 border-t border-brand-800 pt-2 text-xs font-semibold uppercase tracking-wide text-slate-400">Settings</span>
                            {% for item in settings_items %}
                                <a href="{{ path(item.route) }}" {% if item.route == current_route %}aria-current="page" {% endif %}class="pl-2 hover:text-brand-300 hover:underline">{{ item.label }}</a>
                            {% endfor %}
                            <span class="text-slate-300">{{ app.user.fullName }}</span>
                            <a href="{{ path('app_logout') }}" class="hover:text-brand-300 hover:underline">Sign out</a>
                        </div>
                    </div>
                </div>
            </header>
        {% endif %}

        <main class="mx-auto max-w-5xl px-4 py-6">
            {% set flash_styles = {
                error: 'bg-red-50 text-red-700',
                warning: 'bg-amber-50 text-amber-800',
                success: 'bg-green-50 text-green-700',
            } %}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 rounded-md p-3 text-sm {{ flash_styles[label]|default(flash_styles.success) }}" role="alert" aria-live="polite">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
