{% extends 'base.html.twig' %}

{% block title %}Home — UCESCO Volunteer Manager{% endblock %}

{% macro roster_body(roster, empty_message) %}
    {% if roster.isEmpty %}
        <p class="px-5 py-6 text-sm text-slate-500">{{ empty_message }}</p>
    {% else %}
        <div class="px-5 pb-5">
            {% for group in roster.groups %}
                <div class="border-b border-slate-200 py-4 last:border-b-0">
                    <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
                        <span class="font-semibold">{{ group.projectName }}</span>
                        <span class="rounded-full border border-brand-200 bg-brand-100 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-brand-600">
                            {{ group.activityTypeName }}
                        </span>
                    </div>
                    <ul class="mb-2 flex flex-wrap gap-1.5">
                        {% for slot in group.slots %}
                            <li class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-100 py-1 pl-2 pr-2.5 text-[13px]">
                                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>
                                {{ slot.volunteerName }}
                                {% if slot.isLater %}<span class="text-[11px] italic text-slate-400">(later)</span>{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    {% if group.escortNames is not empty %}
                        <p class="text-xs text-slate-500">
                            Accompanied by <b class="font-semibold text-slate-900">{{ group.escortNames|join(', ') }}</b>
                        </p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}

{% import _self as dashboard %}

{% block body %}
    <div class="mb-6">
        <h1 class="text-xl font-semibold">{{ greeting }}, {{ app.user.fullName }}</h1>
        <p class="mt-1 text-sm text-slate-500">{{ today|date('l, j F Y') }}</p>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
        <div class="flex flex-col gap-6 lg:col-span-2">
            <section class="rounded-lg border border-slate-200 bg-white shadow-sm" aria-labelledby="today-heading">
                <div class="flex flex-wrap items-start justify-between gap-3 border-b border-slate-200 px-5 py-4">
                    <div>
                        <h2 id="today-heading" class="font-semibold">Today's roster — {{ todayRoster.date|date('D j M') }}</h2>
                        <p class="mt-0.5 text-xs text-slate-500">
                            {% if todayRoster.isEmpty %}
                                Nothing logged yet
                            {% else %}
                                {{ todayRoster.projectCount }} project{{ todayRoster.projectCount == 1 ? '' : 's' }} ·
                                {{ todayRoster.slotCount }} volunteer{{ todayRoster.slotCount == 1 ? '' : 's' }} today
                            {% endif %}
                        </p>
                    </div>
                    <a href="{{ path('activity_new_batch', {date: todayRoster.date|date('Y-m-d')}) }}"
                       class="rounded-md bg-brand-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-700">
                        + Log activity
                    </a>
                </div>
                {{ dashboard.roster_body(todayRoster, 'Nothing logged for today yet — use “Log activity” to record a session.') }}
            </section>

            <section class="rounded-lg border border-slate-200 bg-white shadow-sm" aria-labelledby="quiet-projects-heading">
                <div class="border-b border-slate-200 px-5 py-4">
                    <h2 id="quiet-projects-heading" class="font-semibold">Projects needing volunteers</h2>
                    <p class="mt-0.5 text-xs text-slate-500">
                        Quiet for {{ quiet_after_days }}+ days — the places to send an arriving volunteer first
                    </p>
                </div>

                {% if quietProjects is empty %}
                    <p class="px-5 py-6 text-sm text-slate-500">Every active project has been visited in the last {{ quiet_after_days }} days.</p>
                {% else %}
                    <ul class="divide-y divide-slate-200">
                        {% for project in quietProjects %}
                            <li class="flex flex-wrap items-center gap-x-3 gap-y-2 px-5 py-3">
                                <div class="min-w-0 flex-1">
                                    <div class="truncate text-sm font-semibold">{{ project.name }}</div>
                                    <div class="mt-0.5 text-xs text-slate-500">
                                        {% if project.hasNeverBeenUsed %}
                                            never visited — added {{ project.days }} days ago
                                        {% else %}
                                            last activity {{ project.lastActivity|date('j M Y') }}
                                        {% endif %}
                                    </div>
                                </div>
                                <span class="shrink-0 rounded-md border px-2 py-1 text-xs font-semibold {{ project.severity.value == 'critical' ? 'border-red-200 bg-red-50 text-red-700' : 'border-amber-200 bg-amber-50 text-amber-800' }}">
                                    {{ project.days }} days
                                </span>
                                <a href="{{ path('activity_new_batch', {project: project.id}) }}"
                                   class="shrink-0 rounded-md border border-slate-300 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:border-brand-500 hover:text-brand-700">
                                    Assign volunteers
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                <div class="border-t border-slate-200 px-5 py-3">
                    <a href="{{ path('report_index') }}" class="text-sm text-brand-600 hover:underline">View full history in Reports →</a>
                </div>
            </section>
        </div>

        <div class="lg:col-span-1">
            <section class="rounded-lg border border-slate-200 bg-white shadow-sm"
                     aria-labelledby="tomorrow-heading"
                     data-controller="clipboard">
                <div class="border-b border-slate-200 px-5 py-4">
                    <h2 id="tomorrow-heading" class="font-semibold">Tomorrow's roster — {{ tomorrowRoster.date|date('D j M') }}</h2>
                    <p class="mt-0.5 text-xs text-slate-500">
                        {% if tomorrowRoster.isEmpty %}
                            Nothing planned yet
                        {% else %}
                            {{ tomorrowRoster.projectCount }} project{{ tomorrowRoster.projectCount == 1 ? '' : 's' }} ·
                            {{ tomorrowRoster.slotCount }} volunteer slot{{ tomorrowRoster.slotCount == 1 ? '' : 's' }} planned
                        {% endif %}
                    </p>
                    <div class="mt-3 flex flex-wrap gap-2">
                        {% if not tomorrowRoster.isEmpty %}
                            <button type="button"
                                    data-action="clipboard#reveal"
                                    class="rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-brand-500 hover:text-brand-700">
                                Copy as text
                            </button>
                        {% endif %}
                        <a href="{{ path('activity_new_batch', {date: tomorrowRoster.date|date('Y-m-d')}) }}"
                           class="rounded-md bg-brand-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-700">
                            + Plan activity
                        </a>
                    </div>
                </div>

                {{ dashboard.roster_body(tomorrowRoster, 'Nothing planned for tomorrow yet — use “Plan activity” to schedule a session.') }}

                {% if not tomorrowRoster.isEmpty %}
                    <div class="border-t border-slate-200 px-5 py-4">
                        <details data-clipboard-target="details">
                            <summary class="cursor-pointer text-sm font-semibold text-brand-600">Preview WhatsApp message</summary>

                            <div class="mt-3 overflow-hidden rounded-md border border-slate-200">
                                <div class="flex items-center justify-between gap-2 border-b border-slate-200 bg-slate-50 px-3 py-2">
                                    <span class="text-[11px] text-slate-500">Schedule only — add your own greeting before sending</span>
                                    <button type="button"
                                            data-action="clipboard#copy"
                                            class="shrink-0 rounded-md border border-slate-300 px-2 py-1 text-xs font-semibold text-slate-700 hover:border-brand-500 hover:text-brand-700">
                                        <span aria-hidden="true">⧉</span> <span data-clipboard-target="label">Copy</span>
                                    </button>
                                </div>
                                <textarea data-clipboard-target="source"
                                          readonly
                                          rows="14"
                                          aria-label="Tomorrow's roster as text"
                                          class="block w-full resize-y border-0 p-3 font-mono text-xs leading-relaxed text-slate-900 focus:ring-0">{{ tomorrowRoster.toWhatsAppText }}</textarea>
                            </div>

                            <p class="mt-2 text-[11px] text-slate-400" data-clipboard-target="status" role="status">
                                This box is always selectable, even if the copy button can't reach the system clipboard.
                            </p>
                        </details>
                    </div>
                {% endif %}
            </section>
        </div>
    </div>
{% endblock %}
