{% extends 'base.html.twig' %}

{% block title %}Indicators — UCESCO Volunteer Manager{% endblock %}

{% block body %}
    <div class="mb-4 flex items-center justify-between">
        <h1 class="text-xl font-semibold">Indicators</h1>
        <div class="flex items-center gap-3">
            <twig:ExportMenu route="indicator_export" />
            <a
                href="{{ path('indicator_new') }}"
                class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"
            >
                Add indicator
            </a>
        </div>
    </div>

    <twig:DataTable :columns="columns" :rows="rows" :pagination="pagination" :sortState="sortState" emptyMessage="No indicators yet — add the first one above." />
{% endblock %}
