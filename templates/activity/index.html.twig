{% extends 'base.html.twig' %}

{% block title %}Activities — UCESCO Volunteer Manager{% endblock %}

{% block body %}
    {# flex-wrap because the heading grows a volunteer's name when the list is
       filtered, which on a phone otherwise squeezes the two buttons to a
       three-line stack. #}
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-xl font-semibold">
            Activities{% if volunteer %} — {{ volunteer.fullName }}{% endif %}{% if program %} — {{ program.project.name }}, {{ program.name }}{% endif %}{% if branch %} — {{ branch.name }}{% endif %}
        </h1>
        <div class="flex items-center gap-3">
            <twig:ExportMenu route="activity_export" />
            <a
                href="{{ path('activity_new') }}"
                class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"
            >
                Log activities
            </a>
        </div>
    </div>

    {#
        The only filters on any index. They sit above both renderings rather than
        inside either, for the reason PaginationBar is hoisted below: the table
        is in `hidden md:block`, so a control rendered there is invisible on a
        phone. Structure copied from PaginationBar's page-size form, down to
        the sr-only submit button that keeps it working with JavaScript off.

        Nothing else needs to know about `branch`, `volunteer` or `program`: the sort
        headers, the page links, the page-size form and the mobile sort
        selects all carry every scalar query param through already, so the
        filters survive a sort click and page 2 on their own. One form, so
        changing one filter keeps the others.
        The volunteer one is also marked data-volunteer-filter for its tests.
    #}
    <form
        method="get"
        class="mb-3 flex flex-wrap items-center gap-2 text-sm text-slate-600 print:hidden"
        data-controller="auto-submit"
        data-volunteer-filter
    >
        {# `page` is dropped on purpose: a new filter means a new page 1. #}
        {% for key, value in app.request.query.all %}
            {% if key not in ['page', 'branch', 'volunteer', 'program'] and value is not iterable %}
                <input type="hidden" name="{{ key }}" value="{{ value }}">
            {% endif %}
        {% endfor %}

        <label for="branch-filter" class="sr-only">Filter by branch</label>
        <span aria-hidden="true">Branch</span>
        <select
            id="branch-filter"
            name="branch"
            class="rounded-md border border-slate-300 px-2 py-1 text-sm focus:border-brand-500 focus:outline-none"
            data-action="change->auto-submit#submit"
        >
            <option value="">All branches</option>
            {% for option in branches %}
                <option value="{{ option.id }}" {{ branch and branch.id == option.id ? 'selected' : '' }}>
                    {{ option.name }}{% if not option.isActive %} (inactive){% endif %}
                </option>
            {% endfor %}
        </select>

        <label for="volunteer-filter" class="sr-only">Filter by volunteer</label>
        <span aria-hidden="true">Volunteer</span>
        <select
            id="volunteer-filter"
            name="volunteer"
            class="rounded-md border border-slate-300 px-2 py-1 text-sm focus:border-brand-500 focus:outline-none"
            data-action="change->auto-submit#submit"
        >
            <option value="">All volunteers</option>
            {% for option in volunteers %}
                <option value="{{ option.id }}" {{ volunteer and volunteer.id == option.id ? 'selected' : '' }}>
                    {{ option.fullName }}{% if not option.isActive %} (inactive){% endif %}
                </option>
            {% endfor %}
        </select>

        <label for="program-filter" class="sr-only">Filter by program</label>
        <span aria-hidden="true">Program</span>
        <select
            id="program-filter"
            name="program"
            class="rounded-md border border-slate-300 px-2 py-1 text-sm focus:border-brand-500 focus:outline-none"
            data-action="change->auto-submit#submit"
        >
            <option value="">All programs</option>
            {# Programs arrive ordered by branch, so a branch change opens the next group. #}
            {% for option in programs %}
                {# Not `branch`: a set inside a for loop leaks past it and would
                   clobber the branch filter. #}
                {% set group = option.project.branch.name %}
                {% if loop.first or group != programs[loop.index0 - 1].project.branch.name %}
                    {% if not loop.first %}</optgroup>{% endif %}
                    <optgroup label="{{ group }}">
                {% endif %}
                <option value="{{ option.id }}" {{ program and program.id == option.id ? 'selected' : '' }}>
                    {{ option.project.name }} — {{ option.name }}
                </option>
                {% if loop.last %}</optgroup>{% endif %}
            {% endfor %}
        </select>

        <button type="submit" class="sr-only">Apply</button>

        {# Only once the list is narrowed to one person is there a profile to
           go to — the return trip for the show page's "See in Activities".
           Inside the form so it sits on the same flex row as the select; it
           submits nothing. The name is sr-only because the heading above
           already says it on screen, but "View profile" alone is poor link
           text out of context. #}
        {% if volunteer %}
            <a
                href="{{ path('volunteer_show', {id: volunteer.id}) }}"
                class="text-brand-600 hover:underline"
            >View profile<span class="sr-only"> for {{ volunteer.fullName }}</span> →</a>
        {% endif %}
    </form>

    {% set empty_message = volunteer or program or branch
        ? 'No activities match these filters.'
        : 'No activities logged yet — log the first one above.'
    %}

    {# Same rows, two renderings: the horizontal-scroll table stays as-is on
       desktop, while narrow screens get one card per activity so a full row
       reads without a sideways swipe. Only one of the two is ever displayed,
       so screen readers see a single list. #}
    <div class="hidden md:block">
        <twig:DataTable :columns="columns" :rows="rows" :sortState="sortState" :emptyMessage="empty_message" />
    </div>

    <div class="md:hidden">
        {% if rows is empty %}
            <p class="rounded-lg border border-slate-200 bg-white px-4 py-6 text-center text-sm text-slate-500">
                {{ empty_message }}
            </p>
        {% else %}
            {# The cards have no header row to click, so sorting reaches mobile
               as a pair of selects emitting the same `sort`/`direction` params
               the <th> links do. Same reason PaginationBar is hoisted out of
               DataTable below: the table is inside `hidden md:block`. #}
            <twig:SortSelect :columns="columns" :sortState="sortState" defaultLabel="Newest first" />

            <ul class="space-y-2" data-activity-cards>
                {% for row in rows %}
                    <li class="rounded-lg border border-slate-200 bg-white px-3 py-2.5 shadow-sm">
                        <div class="mb-1 flex items-center justify-between gap-2">
                            <span class="text-[11px] font-bold uppercase tracking-wide {{ row.planned|default(false) ? 'text-brand-600' : 'text-slate-500' }}">
                                {{ row.cells.date }}{% if row.planned|default(false) %} · Planned{% endif %}
                            </span>
                            <span class="shrink-0 rounded-full border border-brand-200 bg-brand-100 px-2 py-0.5 text-[11px] font-semibold text-brand-600">
                                {{ row.cells.duration }}
                            </span>
                        </div>
                        <div class="text-sm font-semibold">{{ row.cells.volunteer }}</div>
                        <p class="mt-0.5 text-xs text-slate-500">{{ row.cells.project }} — {{ row.cells.program }} · {{ row.cells.activityType }}</p>
                        {% if row.cells.escorts != '—' %}
                            <p class="mt-0.5 text-xs text-slate-500">Accompanied by {{ row.cells.escorts }}</p>
                        {% endif %}
                        <div class="mt-2 flex gap-4 text-[11.5px] font-semibold">
                            <twig:RowActions
                                :actions="row.actions"
                                linkClass="text-slate-500 hover:underline"
                                buttonClass="text-red-700 hover:underline"
                            />
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    {# The one index that renders its own bar instead of letting DataTable do
       it: DataTable lives inside `hidden md:block` above, so a bar rendered
       there would be invisible on mobile — capping the card list at one page
       with no way to reach the next. Rendered here, it serves both. #}
    <twig:PaginationBar :pagination="pagination" />
{% endblock %}
