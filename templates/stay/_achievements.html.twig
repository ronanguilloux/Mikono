{# The stay's achievements with Edit/Delete, on its show and edit pages. #}
<div class="mb-6 rounded-lg border border-slate-200 bg-white p-4" data-achievements>
    <div class="mb-3 flex items-center justify-between">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Achievements</h2>
        <a href="{{ path('stay_achievement_new', {id: stay.id}) }}" class="text-sm text-brand-600 hover:underline">+ Add achievement</a>
    </div>
    <ul class="divide-y divide-slate-100">
        {% for row in achievements %}
            {% set achievement = row.achievement %}
            <li class="flex flex-wrap items-start justify-between gap-2 py-2">
                <div class="text-sm">
                    <div class="font-medium text-slate-800">{{ achievement.title }}</div>
                    <div class="text-slate-600">{{ achievement.achievedOn|date('j M Y') }} · {{ achievement.project.name }}</div>
                    {% if achievement.description %}
                        <p class="mt-1 whitespace-pre-line text-slate-600">{{ achievement.description }}</p>
                    {% endif %}
                </div>
                <div class="flex gap-3 text-sm">
                    <twig:RowActions :actions="row.actions" />
                </div>
            </li>
        {% else %}
            <li class="text-sm text-slate-400">No achievements in this stay yet.</li>
        {% endfor %}
    </ul>
</div>
