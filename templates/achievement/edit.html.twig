{% extends 'base.html.twig' %}

{% block title %}Edit achievement for {{ volunteer.fullName }} — UCESCO Volunteer Manager{% endblock %}

{% block body %}
    <h1 class="mb-1 text-xl font-semibold">Edit achievement for {{ volunteer.fullName }}</h1>
    <p class="mb-4 text-sm text-slate-600"><a href="{{ path('stay_show', {id: stay.id}) }}" class="text-brand-600 hover:underline">Stay at {{ stay.branch.name }}, {{ stay.startDate|date('j M Y') }} – {{ stay.endDate|date('j M Y') }}</a></p>
    <twig:FormShell :form="form" cancelUrl="{{ path('stay_show', {id: stay.id}) }}" />
{% endblock %}
