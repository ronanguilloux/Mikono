{% extends 'base.html.twig' %}

{% block title %}Add achievement for {{ volunteer.fullName }} — UCESCO Volunteer Manager{% endblock %}

{% block body %}
    <h1 class="mb-1 text-xl font-semibold">Add an achievement for {{ volunteer.fullName }}</h1>
    <p class="mb-1 text-sm text-slate-600"><a href="{{ path('stay_show', {id: stay.id}) }}" class="text-brand-600 hover:underline">Stay at {{ stay.branch.name }}, {{ stay.startDate|date('j M Y') }} – {{ stay.endDate|date('j M Y') }}</a></p>
    <p class="mb-4 text-sm text-slate-600" data-indicators-link>Counting something? Pick its indicator below, or add a missing one under <a href="{{ path('indicator_index') }}" class="text-brand-600 hover:underline">Settings → Indicators</a>.</p>
    <twig:FormShell :form="form" cancelUrl="{{ path('stay_show', {id: stay.id}) }}" />
{% endblock %}
