{% extends 'base.html.twig' %}

{% block title %}Edit {{ volunteer.fullName }} — UCESCO Volunteer Manager{% endblock %}

{% block body %}
    <a href="{{ path('volunteer_show', {id: volunteer.id}) }}" class="mb-4 inline-block text-sm text-slate-600 hover:underline">← Back to {{ volunteer.fullName }}</a>

    {# The show page's header, so the switch to edit keeps its bearings. #}
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            {% if volunteer.photo %}
                <img
                    src="{{ path('volunteer_photo', {id: volunteer.id, v: volunteer.photo.id}) }}"
                    alt="Current photo of {{ volunteer.fullName }}"
                    class="h-20 w-20 shrink-0 rounded-full object-cover"
                >
            {% else %}
                <span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xl font-semibold text-slate-500" aria-hidden="true">
                    {{- volunteer.firstName|first|upper }}{{ (volunteer.lastName ?? '')|first|upper -}}
                </span>
            {% endif %}
            <h1 class="flex flex-wrap items-center gap-2 text-xl font-semibold">
                Edit {{ volunteer.fullName }}
                {% set status = volunteer.status(today) %}
                <twig:Pill :tone="status.tone">{{ status.label }}</twig:Pill>
            </h1>
        </div>
        {% if deleteGuardReason %}
            <a
                href="{{ path('activity_index', {volunteer: volunteer.id}) }}"
                class="whitespace-nowrap text-sm text-brand-600 hover:underline"
            >See in Activities →</a>
        {% endif %}
    </div>

    {{ include('volunteer/_form.html.twig', {cancelUrl: path('volunteer_show', {id: volunteer.id})}) }}

    {# Stays aren't form fields; each has its own screen, linked from here too. #}
    <div class="mt-6 rounded-lg border border-slate-200 bg-white p-4" data-stays>
        <div class="mb-3 flex items-center justify-between">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500"><span aria-hidden="true">🧳</span> Stays</h2>
            <a href="{{ path('volunteer_stay_new', {id: volunteer.id}) }}" class="text-sm text-brand-600 hover:underline">+ Add stay</a>
        </div>
        <ul class="divide-y divide-slate-100">
            {% for stay in volunteer.stays|sort((a, b) => b.startDate <=> a.startDate) %}
                <li class="flex items-center justify-between gap-2 py-2 text-sm">
                    <span>
                        <span class="font-medium text-slate-800">{{ stay.branch.name }}</span>
                        <span class="text-slate-600">· {{ stay.startDate|date('j M Y') }} – {{ stay.endDate|date('j M Y') }}</span>
                    </span>
                    <a href="{{ path('stay_edit', {id: stay.id}) }}" class="text-brand-600 hover:underline">Edit</a>
                </li>
            {% else %}
                <li class="text-sm text-slate-400">No stays yet — add one before logging activities.</li>
            {% endfor %}
        </ul>
    </div>

    {#
        The delete-guard, with the same sentence the flash would carry if a
        delete were attempted anyway. At the bottom: someone opening Edit came
        to edit, so it shouldn't be the first thing they read. A note rather
        than a flash — it describes a standing state, not the outcome of an
        action.
    #}
    {% if deleteGuardReason %}
        <p
            class="mt-6 rounded-md border border-amber-200 bg-amber-50 px-4 py-2.5 text-sm text-amber-900"
            data-delete-guard-note
        >{{ deleteGuardReason }}</p>
    {% endif %}
{% endblock %}
