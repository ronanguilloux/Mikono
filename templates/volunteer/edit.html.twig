{% extends 'base.html.twig' %}

{% block title %}Edit {{ volunteer.fullName }} — UCESCO Volunteer Manager{% endblock %}

{% block body %}
    <h1 class="mb-4 text-xl font-semibold">Edit {{ volunteer.fullName }}</h1>

    {#
        The delete-guard, said where it matters: on this volunteer's own screen,
        with the same sentence the flash would carry if a delete were attempted
        anyway. A note rather than a flash — it describes a standing state, not
        the outcome of an action.
    #}
    {% if deleteGuardReason %}
        <p
            class="mb-4 max-w-lg rounded-md border border-amber-200 bg-amber-50 px-4 py-2.5 text-sm text-amber-900"
            data-delete-guard-note
        >
            {{ deleteGuardReason }}
            <a
                href="{{ path('activity_index', {volunteer: volunteer.id}) }}"
                class="whitespace-nowrap font-medium underline"
            >See in Activities →</a>
        </p>
    {% endif %}

    {% if volunteer.photo %}
        <img
            src="{{ path('volunteer_photo', {id: volunteer.id, v: volunteer.photo.id}) }}"
            alt="Current photo of {{ volunteer.fullName }}"
            class="mb-4 h-24 w-24 rounded-full object-cover"
        >
    {% endif %}

    <twig:FormShell :form="form" cancelUrl="{{ path('volunteer_index') }}" />

    {# Stays aren't form fields; each has its own screen, linked from here too. #}
    <div class="mt-8 max-w-lg rounded-lg border border-slate-200 bg-white p-4" data-stays>
        <div class="mb-3 flex items-center justify-between">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Stays</h2>
            <a href="{{ path('volunteer_stay_new', {id: volunteer.id}) }}" class="text-sm text-brand-600 hover:underline">+ Add stay</a>
        </div>
        <ul class="divide-y divide-slate-100">
            {% for stay in volunteer.stays|sort((a, b) => b.startDate <=> a.startDate) %}
                <li class="flex items-center justify-between gap-2 py-2 text-sm">
                    <span>
                        <span class="font-medium text-slate-800">{{ stay.branch.name }}</span>
                        <span class="text-slate-600">· {{ stay.startDate|date('j M Y') }} – {{ stay.endDate|date('j M Y') }}</span>
                    </span>
                    <a href="{{ path('stay_edit', {id: stay.id}) }}" class="text-brand-600 hover:underline">Edit</a>
                </li>
            {% else %}
                <li class="text-sm text-slate-400">No stays yet — add one before logging activities.</li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
