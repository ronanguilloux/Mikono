{% extends 'base.html.twig' %}

{% block title %}Volunteers — UCESCO Volunteer Manager{% endblock %}

{% block body %}
    <div class="mb-4 flex items-center justify-between">
        <h1 class="text-xl font-semibold">Volunteers</h1>
        <a
            href="{{ path('volunteer_new') }}"
            class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"
        >
            Add volunteer
        </a>
    </div>

    {#
        No page-level note about the greyed-out Delete links below: the rows
        say it themselves via disabledReason, and the reason in words lives on
        the one screen where someone is actually trying to delete a volunteer,
        volunteer/edit.html.twig.
    #}
    <twig:DataTable :columns="columns" :rows="rows" :pagination="pagination" :sortState="sortState" emptyMessage="No volunteers yet — add the first one above." />
{% endblock %}
