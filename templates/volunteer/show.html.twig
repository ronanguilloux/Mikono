{% extends 'base.html.twig' %}

{% block title %}{{ volunteer.fullName }} — UCESCO Volunteer Manager{% endblock %}

{% block body %}
    <a href="{{ path('volunteer_index') }}" class="mb-4 inline-block text-sm text-slate-600 hover:underline">← Back to Volunteers</a>

    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div class="flex items-center gap-4">
            {% if volunteer.photo %}
                <img
                    src="{{ path('volunteer_photo', {id: volunteer.id, v: volunteer.photo.updatedAt|date('U')}) }}"
                    alt="Photo of {{ volunteer.fullName }}"
                    class="h-20 w-20 shrink-0 rounded-full object-cover"
                    data-volunteer-photo
                >
            {% else %}
                <a
                    href="{{ path('volunteer_edit', {id: volunteer.id}) }}"
                    class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xl font-semibold text-slate-500 hover:bg-slate-200"
                    title="Add a photo"
                >
                    <span aria-hidden="true">{{ volunteer.firstName|first|upper }}{{ (volunteer.lastName ?? '')|first|upper }}</span>
                    <span class="sr-only">Add a photo</span>
                </a>
            {% endif %}
            <div>
                <h1 class="flex flex-wrap items-center gap-2 text-xl font-semibold">
                    {{ volunteer.fullName }}
                    <span class="rounded-full px-2 py-0.5 text-xs font-medium {{ volunteer.active ? 'bg-accent-100 text-accent-800' : 'bg-slate-100 text-slate-600' }}">
                        {{ volunteer.active ? 'Active' : 'Inactive' }}
                    </span>
                    {% if volunteer.profileIncomplete %}
                        <a
                            href="{{ path('volunteer_edit', {id: volunteer.id}) }}"
                            class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800 hover:bg-amber-200"
                            data-profile-incomplete
                        >Incomplete profile</a>
                    {% endif %}
                </h1>
                <p class="mt-1 text-sm text-slate-500" data-volunteer-since>
                    {% if firstActivity is null %}
                        Added on {{ volunteer.createdAt|date('j F Y') }}
                    {% elseif firstActivity > today %}
                        First activity planned for {{ firstActivity|date('j F Y') }}
                    {% else %}
                        Volunteer since {{ firstActivity|date('j F Y') }}
                    {% endif %}
                </p>
            </div>
        </div>
        <div class="flex gap-2">
            <a
                href="{{ path('volunteer_edit', {id: volunteer.id}) }}"
                class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
            >
                Edit
            </a>
            <a
                href="{{ path('activity_new') }}"
                class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"
            >
                Log activity
            </a>
        </div>
    </div>

    <div class="mb-6 rounded-lg border border-slate-200 bg-white p-4">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">At a glance</h2>
        <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <div>
                <dt class="text-xs text-slate-500">Email</dt>
                <dd class="mt-0.5 text-sm">{{ volunteer.email ?: '—' }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Phone</dt>
                <dd class="mt-0.5 text-sm">
                    {% if volunteer.phone %}
                        {{ volunteer.phone }}
                    {% else %}
                        <span class="text-slate-400">Not on file</span>
                        <a href="{{ path('volunteer_edit', {id: volunteer.id}) }}" class="ml-1 text-brand-600 hover:underline">+ Add</a>
                    {% endif %}
                </dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Branch</dt>
                <dd class="mt-0.5 text-sm" data-branch-of-attachment>{{ volunteer.branchOfAttachment.name ?? '—' }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Activities logged</dt>
                <dd class="mt-0.5 text-sm font-semibold">{{ activityCount }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Total days</dt>
                <dd class="mt-0.5 text-sm font-semibold">{{ totalDays }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Most recent activity</dt>
                <dd class="mt-0.5 text-sm">
                    {% if mostRecent %}
                        {{ mostRecent|date('j M Y') }}
                        {% if mostRecentIsPlanned %}
                            <span class="ml-1 rounded-full bg-brand-100 px-2 py-0.5 text-xs font-medium text-brand-700">Planned</span>
                        {% endif %}
                    {% else %}
                        —
                    {% endif %}
                </dd>
            </div>
        </dl>
    </div>

    <div class="mb-6 rounded-lg border border-slate-200 bg-white p-4" data-profile>
        <div class="mb-3 flex items-center justify-between">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Profile</h2>
            <a href="{{ path('volunteer_edit', {id: volunteer.id}) }}" class="text-sm text-brand-600 hover:underline">Edit</a>
        </div>
        {% set notOnFile %}
            <span class="text-slate-400">Not on file</span>
            <a href="{{ path('volunteer_edit', {id: volunteer.id}) }}" class="ml-1 text-brand-600 hover:underline">+ Add</a>
        {% endset %}
        <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <div>
                <dt class="text-xs text-slate-500">Nationality</dt>
                <dd class="mt-0.5 text-sm">{{ nationalityName ?? notOnFile }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Country of residence</dt>
                <dd class="mt-0.5 text-sm">{{ residenceName ?? notOnFile }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Date of birth</dt>
                <dd class="mt-0.5 text-sm">
                    {% if volunteer.dateOfBirth %}
                        {{ volunteer.dateOfBirth|date('j M Y') }}
                        <span class="text-slate-500">· {{ volunteer.dateOfBirth.diff(today).y }} years old</span>
                    {% else %}
                        {{ notOnFile }}
                    {% endif %}
                </dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Profession</dt>
                <dd class="mt-0.5 text-sm">{{ volunteer.profession ?? notOnFile }}</dd>
            </div>
            {% for field in [
                {label: 'Skills', value: volunteer.skills},
                {label: 'Interests', value: volunteer.interests},
                {label: 'Emergency contacts', value: volunteer.emergencyContacts},
            ] %}
                <div class="sm:col-span-2 lg:col-span-3">
                    <dt class="text-xs text-slate-500">{{ field.label }}</dt>
                    <dd class="mt-0.5 text-sm {{ field.value ? 'whitespace-pre-line text-slate-700' }}">{{ field.value ?? notOnFile }}</dd>
                </div>
            {% endfor %}
        </dl>
    </div>

    <div class="mb-6 rounded-lg border border-slate-200 bg-white p-4" data-stays>
        {#
            A stay is a stint at one branch. Activities can only be logged on a
            day a stay covers, and "Active" above means a stay covers today.
        #}
        <div class="mb-3 flex items-center justify-between">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Stays</h2>
            <a href="{{ path('volunteer_stay_new', {id: volunteer.id}) }}" class="text-sm text-brand-600 hover:underline">+ Add stay</a>
        </div>
        <ul class="divide-y divide-slate-100">
            {% for row in stays %}
                {% set stay = row.stay %}
                <li class="flex flex-wrap items-center justify-between gap-2 py-2">
                    <div class="text-sm">
                        <span class="font-medium text-slate-800">{{ stay.branch.name }}</span>
                        <span class="text-slate-600">· {{ stay.startDate|date('j M Y') }} – {{ stay.endDate|date('j M Y') }}</span>
                        {% if stay.covers(today) %}
                            <span class="ml-1 rounded-full bg-accent-100 px-2 py-0.5 text-xs font-medium text-accent-800">Current</span>
                        {% elseif stay.startDate > today %}
                            <span class="ml-1 rounded-full bg-brand-100 px-2 py-0.5 text-xs font-medium text-brand-700">Upcoming</span>
                        {% else %}
                            <span class="ml-1 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">Past</span>
                        {% endif %}
                    </div>
                    <div class="flex gap-3 text-sm">
                        <twig:RowActions :actions="row.actions" />
                    </div>
                </li>
            {% else %}
                <li class="text-sm text-slate-400">No stays yet — add one before logging activities.</li>
            {% endfor %}
        </ul>
    </div>

    <div class="mb-6 rounded-lg border border-slate-200 bg-white p-4">
        <div class="mb-3 flex items-center justify-between">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Notes</h2>
            <a href="{{ path('volunteer_edit', {id: volunteer.id}) }}" class="text-sm text-brand-600 hover:underline">Edit</a>
        </div>
        {% if volunteer.notes %}
            <p class="whitespace-pre-line text-sm text-slate-700">{{ volunteer.notes }}</p>
        {% else %}
            <p class="text-sm text-slate-400">No notes yet.</p>
        {% endif %}
    </div>

    <div class="rounded-lg border border-slate-200 bg-white p-4">
        {#
            The timeline below is read-only. The link goes to the same
            activities in the Activities index, where they can be edited,
            deleted and paged — same idiom as the Notes section's Edit link.
        #}
        <div class="mb-3 flex items-center justify-between">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Activity history</h2>
            <a
                href="{{ path('activity_index', {volunteer: volunteer.id}) }}"
                class="text-sm text-brand-600 hover:underline"
            >See in Activities →</a>
        </div>
        <ul class="space-y-4">
            {% for activity in activities %}
                {% set isPlanned = activity.date > today %}
                {% set durationLabel = activity.duration.value == 'other' ? (activity.durationOther ?: activity.duration.label) : activity.duration.label %}
                <li class="relative border-l-2 {{ isPlanned ? 'border-brand-200' : 'border-slate-200' }} pl-4">
                    <span
                        class="absolute -left-[7px] top-1 h-3 w-3 rounded-full {{ isPlanned ? 'border-2 border-brand-500 bg-white' : 'bg-brand-500' }}"
                        aria-hidden="true"
                    ></span>
                    <div class="text-sm font-medium text-slate-800">
                        {{ activity.date|date('D j M Y') }}{% if isPlanned %} · Planned{% endif %}
                    </div>
                    <div class="text-sm text-slate-600">{{ activity.program.name }} · {{ activity.project.name }} · {{ activity.stay.branch.name }}</div>
                    <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-slate-500">
                        <span class="rounded-full bg-slate-100 px-2 py-0.5">{{ activity.activityType.name }}</span>
                        <span>{{ durationLabel }}</span>
                    </div>
                    {% if activity.notes %}
                        <p class="mt-1 text-sm text-slate-600 italic">"{{ activity.notes }}"</p>
                    {% endif %}
                </li>
            {% else %}
                <li class="text-sm text-slate-500">No activities logged yet.</li>
            {% endfor %}
        </ul>
        {% if activities|length > 0 %}
            <p class="mt-4 text-xs text-slate-400">Showing all {{ activityCount }} logged activit{{ activityCount == 1 ? 'y' : 'ies' }}.</p>
        {% endif %}
    </div>
{% endblock %}
