{% extends 'base.html.twig' %}

{% block title %}{{ volunteer.fullName }} — UCESCO Volunteer Manager{% endblock %}

{% block body %}
    <a href="{{ path('volunteer_index') }}" class="mb-4 inline-block text-sm text-slate-600 hover:underline">← Back to Volunteers</a>

    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div class="flex items-center gap-4">
            {% if volunteer.photo %}
                <img
                    src="{{ path('volunteer_photo', {id: volunteer.id, v: volunteer.photo.id}) }}"
                    alt="Photo of {{ volunteer.fullName }}"
                    class="h-20 w-20 shrink-0 rounded-full object-cover"
                    data-volunteer-photo
                >
            {% else %}
                <a
                    href="{{ path('volunteer_edit', {id: volunteer.id, _fragment: 'glance'}) }}"
                    class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xl font-semibold text-slate-500 hover:bg-slate-200"
                    title="Add a photo"
                >
                    <span aria-hidden="true">{{ volunteer.firstName|first|upper }}{{ (volunteer.lastName ?? '')|first|upper }}</span>
                    <span class="sr-only">Add a photo</span>
                </a>
            {% endif %}
            <div>
                <h1 class="flex flex-wrap items-center gap-2 text-xl font-semibold">
                    {{ volunteer.fullName }}
                    {% set status = volunteer.status(today) %}
                    <twig:Pill :tone="status.tone">{{ status.label }}</twig:Pill>
                    {% if volunteer.profileIncomplete %}
                        <a
                            href="{{ path('volunteer_edit', {id: volunteer.id}) }}"
                            class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800 hover:bg-amber-200"
                            data-profile-incomplete
                        >Incomplete profile</a>
                    {% endif %}
                </h1>
                <p class="mt-1 text-sm text-slate-500" data-volunteer-since>
                    {% if firstActivity is null %}
                        Added on {{ volunteer.createdAt|date('j F Y') }}
                    {% elseif firstActivity > today %}
                        First activity planned for {{ firstActivity|date('j F Y') }}
                    {% else %}
                        Volunteer since {{ firstActivity|date('j F Y') }}
                    {% endif %}
                </p>
                {# Null for records from before ADR 0043 or written from the console; then say nothing. #}
                {% set editedLater = volunteer.updatedBy and volunteer.updatedAt > volunteer.createdAt %}
                {% if volunteer.createdBy or editedLater %}
                    {% import _self as authors %}
                    <p class="mt-0.5 text-xs text-slate-500" data-volunteer-authors>
                        {%- if volunteer.createdBy %}Added by {{ authors.name(volunteer.createdBy) }} on {{ volunteer.createdAt|date('j F Y') }}{% endif -%}
                        {%- if volunteer.createdBy and editedLater %} · {% endif -%}
                        {%- if editedLater %}{{ volunteer.createdBy ? 'last' : 'Last' }} edited by {{ authors.name(volunteer.updatedBy) }} on {{ volunteer.updatedAt|date('j F Y') }}{% endif -%}
                    </p>
                {% endif %}
            </div>
        </div>
        <div class="flex gap-2">
            <a
                href="{{ path('volunteer_edit', {id: volunteer.id}) }}"
                class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
            >
                Edit
            </a>
            <a
                href="{{ path('activity_new', {volunteer: volunteer.id}) }}"
                class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"
            >
                Log activity
            </a>
        </div>
    </div>

    <div class="mb-6 rounded-lg border border-slate-200 bg-white p-4">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500"><span aria-hidden="true">📌</span> At a glance</h2>
        <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <div>
                <dt class="text-xs text-slate-500">Email</dt>
                <dd class="mt-0.5 text-sm">{{ volunteer.email ?: '—' }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Phone</dt>
                <dd class="mt-0.5 text-sm">
                    {% if volunteer.phone %}
                        {{ volunteer.phone }}
                    {% else %}
                        <span class="text-slate-400">Not on file</span>
                        <a href="{{ path('volunteer_edit', {id: volunteer.id, _fragment: 'glance'}) }}" class="ml-1 text-brand-600 hover:underline">+ Add</a>
                    {% endif %}
                </dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Branch</dt>
                <dd class="mt-0.5 text-sm" data-branch-of-attachment>{{ volunteer.branchOfAttachment.name ?? '—' }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Activities logged</dt>
                <dd class="mt-0.5 text-sm font-semibold">{{ activityCount }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Days on site</dt>
                <dd class="mt-0.5 text-sm font-semibold" data-days-on-site>{{ daysOnSite }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Days logged</dt>
                <dd class="mt-0.5 text-sm font-semibold" data-days-logged>{{ daysLogged }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Most recent activity</dt>
                <dd class="mt-0.5 text-sm">
                    {% if mostRecent %}
                        {{ mostRecent|date('j M Y') }}
                        {% if mostRecentIsPlanned %}
                            <span class="ml-1 rounded-full bg-brand-100 px-2 py-0.5 text-xs font-medium text-brand-700">Planned</span>
                        {% endif %}
                    {% else %}
                        —
                    {% endif %}
                </dd>
            </div>
        </dl>
    </div>

    {{ include('volunteer/_impact.html.twig') }}

    <div class="mb-6 rounded-lg border border-slate-200 bg-white p-4" data-achievements>
        {# What the volunteer left behind, newest first; added from a stay below. #}
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500"><span aria-hidden="true">🏅</span> Achievements</h2>
        <ul class="divide-y divide-slate-100">
            {% for row in achievements %}
                {% set achievement = row.achievement %}
                <li class="flex flex-wrap items-start justify-between gap-2 py-2">
                    <div class="text-sm">
                        <div class="font-medium text-slate-800">{{ achievement.title }}</div>
                        <div class="text-slate-600">{{ achievement.achievedOn|date('j M Y') }} · {{ achievement.project.name }} · {{ achievement.stay.branch.name }}{% if achievement.indicator %} · {{ achievement.quantity|number_format }} {{ achievement.indicator.name }}{% endif %}</div>
                        {% if achievement.description %}
                            <p class="mt-1 whitespace-pre-line text-slate-600">{{ achievement.description }}</p>
                        {% endif %}
                    </div>
                    <div class="flex gap-3 text-sm">
                        <twig:RowActions :actions="row.actions" />
                    </div>
                </li>
            {% else %}
                <li class="text-sm text-slate-400">No achievements yet — add one from a stay below.</li>
            {% endfor %}
        </ul>
    </div>

    <div class="mb-6 rounded-lg border border-slate-200 bg-white p-4" data-stays>
        {#
            A stay is a stint at one branch. Activities can only be logged on a
            day a stay covers. The status above reads these: Present when a
            stay covers today, else Upcoming when one starts later, else Past;
            No stay until the first one is added.
        #}
        <div class="mb-3 flex items-center justify-between">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500"><span aria-hidden="true">🧳</span> Stays</h2>
            <a href="{{ path('volunteer_stay_new', {id: volunteer.id}) }}" class="text-sm text-brand-600 hover:underline">+ Add stay</a>
        </div>
        <ul class="divide-y divide-slate-100">
            {% for row in stays %}
                {% set stay = row.stay %}
                <li class="flex flex-wrap items-center justify-between gap-2 py-2">
                    <div class="text-sm">
                        <span class="font-medium text-slate-800">{{ stay.branch.name }}</span>
                        <span class="text-slate-600">· {{ stay.startDate|date('j M Y') }} – {{ stay.endDate|date('j M Y') }}</span>
                        {% if stay.covers(today) %}
                            <span class="ml-1 rounded-full bg-accent-100 px-2 py-0.5 text-xs font-medium text-accent-800">Current</span>
                        {% elseif stay.startDate > today %}
                            <span class="ml-1 rounded-full bg-brand-100 px-2 py-0.5 text-xs font-medium text-brand-700">Upcoming</span>
                        {% else %}
                            <span class="ml-1 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">Past</span>
                        {% endif %}
                    </div>
                    <div class="flex gap-3 text-sm">
                        <a href="{{ path('stay_achievement_new', {id: stay.id}) }}" class="text-brand-600 hover:underline">+ Achievement</a>
                        <twig:RowActions :actions="row.actions" />
                    </div>
                </li>
            {% else %}
                <li class="text-sm text-slate-400">No stays yet — add one before logging activities.</li>
            {% endfor %}
        </ul>
    </div>

    <div class="mb-6 rounded-lg border border-slate-200 bg-white p-4" data-profile>
        <div class="mb-3 flex items-center justify-between">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500"><span aria-hidden="true">🪪</span> Profile</h2>
            <a href="{{ path('volunteer_edit', {id: volunteer.id, _fragment: 'profile'}) }}" class="text-sm text-brand-600 hover:underline">Edit</a>
        </div>
        {% set notOnFile %}
            <span class="text-slate-400">Not on file</span>
            <a href="{{ path('volunteer_edit', {id: volunteer.id, _fragment: 'profile'}) }}" class="ml-1 text-brand-600 hover:underline">+ Add</a>
        {% endset %}
        <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <div>
                <dt class="text-xs text-slate-500">Nationality</dt>
                <dd class="mt-0.5 text-sm">{{ nationalityName ?? notOnFile }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Country of residence</dt>
                <dd class="mt-0.5 text-sm">{{ residenceName ?? notOnFile }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Date of birth</dt>
                <dd class="mt-0.5 text-sm">
                    {% if volunteer.dateOfBirth %}
                        {{ volunteer.dateOfBirth|date('j M Y') }}
                        <span class="text-slate-500">· {{ volunteer.dateOfBirth.diff(today).y }} years old</span>
                    {% else %}
                        {{ notOnFile }}
                    {% endif %}
                </dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Gender</dt>
                <dd class="mt-0.5 text-sm">{{ volunteer.gender ? volunteer.gender.label() : notOnFile }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Profession</dt>
                <dd class="mt-0.5 text-sm">{{ volunteer.profession ?? notOnFile }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Supervisor</dt>
                <dd class="mt-0.5 text-sm">{{ volunteer.supervisor ?? notOnFile }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Accommodation preference</dt>
                <dd class="mt-0.5 text-sm">{{ volunteer.accommodationPreference ?? notOnFile }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500"><span aria-hidden="true">🛬</span> Airport for pickup</dt>
                <dd class="mt-0.5 text-sm">{{ volunteer.pickupAirport ?? notOnFile }}</dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500">Passport</dt>
                <dd class="mt-0.5 text-sm" data-passport>
                    {% if passportNumber or volunteer.passportExpiresOn %}
                        {{ passportNumber ?? 'Number not on file' }}
                        {% if volunteer.passportExpiresOn %}
                            <span class="text-slate-500">· expires {{ volunteer.passportExpiresOn|date('j M Y') }}</span>
                            {% if volunteer.passportExpired(today) %}
                                <span class="ml-1 whitespace-nowrap rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800" data-passport-expired>Expired</span>
                            {% elseif volunteer.passportExpiringSoon(today) %}
                                <span class="ml-1 whitespace-nowrap rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800" data-passport-expiring>Expires soon</span>
                            {% endif %}
                        {% endif %}
                    {% else %}
                        {{ notOnFile }}
                    {% endif %}
                </dd>
            </div>
            <div>
                <dt class="text-xs text-slate-500"><span aria-hidden="true">🗂️</span> GDrive folder</dt>
                <dd class="mt-0.5 break-all text-sm" data-drive-folder>
                    {% if volunteer.driveFolderUrl %}
                        <a href="{{ volunteer.driveFolderUrl }}" target="_blank" rel="noopener noreferrer nofollow" class="text-brand-600 hover:underline">{{ volunteer.driveFolderUrl }}</a>
                    {% else %}
                        {{ notOnFile }}
                    {% endif %}
                </dd>
            </div>
            {% for field in [
                {label: 'Skills', emoji: '🌟', value: volunteer.skills is empty ? null : volunteer.skills|map(s => s.name)|join(', ')},
                {label: 'Sources', value: volunteer.sources is empty ? null : volunteer.sources|map(s => s.name)|join(', ')},
                {label: 'Interests', value: volunteer.interests},
                {label: 'Emergency contacts', value: volunteer.emergencyContacts},
            ] %}
                <div class="sm:col-span-2 lg:col-span-3">
                    <dt class="text-xs text-slate-500">{% if field.emoji ?? null %}<span aria-hidden="true">{{ field.emoji }}</span> {% endif %}{{ field.label }}</dt>
                    <dd class="mt-0.5 text-sm {{ field.value ? 'whitespace-pre-line text-slate-700' }}">{{ field.value ?? notOnFile }}</dd>
                </div>
            {% endfor %}
        </dl>
    </div>

    {#
        The intro form's other answers (brainstorm 15). Only what's on file is
        listed, and the card is left out when nothing is, so a profile entered
        by hand doesn't grow fifteen "Not on file" rows.
    #}
    {% set background = [
        {label: 'Instagram', value: volunteer.instagram, url: volunteer.instagramHandle ? 'https://www.instagram.com/' ~ volunteer.instagramHandle ~ '/', link: '@' ~ volunteer.instagramHandle},
        {label: 'Facebook', value: volunteer.facebook},
        {label: 'Twitter / X', value: volunteer.twitter},
        {label: 'TikTok', value: volunteer.tiktok},
        {label: 'LinkedIn', value: volunteer.linkedin},
        {label: 'Employer', value: volunteer.employer},
        {label: 'School / university', value: volunteer.education},
        {label: 'Favourite food', value: volunteer.favouriteFood},
        {label: 'Accommodation address', value: volunteer.accommodationAddress},
        {label: 'Previous volunteering with children', value: volunteer.experienceWithChildren is null ? null : (volunteer.experienceWithChildren ? 'Yes' : 'No')},
        {label: 'Hobbies', value: volunteer.hobbies, wide: true},
        {label: 'Free-time activities wished', value: volunteer.freeTimeActivities, wide: true},
        {label: 'Skills, in their words', value: volunteer.skillsDescription, wide: true},
        {label: 'Why UCESCO', value: volunteer.motivation, wide: true},
        {label: 'Legacy record', value: volunteer.legacyRecord, wide: true},
    ]|filter(f => f.value is not null) %}
    {% if background is not empty %}
        <div class="mb-6 rounded-lg border border-slate-200 bg-white p-4" data-background>
            <div class="mb-3 flex items-center justify-between">
                <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500"><span aria-hidden="true">📋</span> Background</h2>
                <a href="{{ path('volunteer_edit', {id: volunteer.id, _fragment: 'background'}) }}" class="text-sm text-brand-600 hover:underline">Edit</a>
            </div>
            <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {% for field in background %}
                    <div class="{{ (field.wide ?? false) ? 'sm:col-span-2 lg:col-span-3' }}">
                        <dt class="text-xs text-slate-500">{{ field.label }}</dt>
                        <dd class="mt-0.5 whitespace-pre-line break-words text-sm text-slate-700">
                            {%- if field.url ?? null -%}
                                <a href="{{ field.url }}" target="_blank" rel="noopener noreferrer nofollow" class="text-brand-600 hover:underline">{{ field.link }}</a>
                            {%- else -%}
                                {{ field.value }}
                            {%- endif -%}
                        </dd>
                    </div>
                {% endfor %}
            </dl>
        </div>
    {% endif %}

    <div class="mb-6 rounded-lg border border-slate-200 bg-white p-4">
        <div class="mb-3 flex items-center justify-between">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500"><span aria-hidden="true">📝</span> Notes</h2>
            <a href="{{ path('volunteer_edit', {id: volunteer.id, _fragment: 'notes'}) }}" class="text-sm text-brand-600 hover:underline">Edit</a>
        </div>
        {% if volunteer.notes %}
            <p class="whitespace-pre-line text-sm text-slate-700">{{ volunteer.notes }}</p>
        {% else %}
            <p class="text-sm text-slate-400">No notes yet.</p>
        {% endif %}
    </div>

    {{ include('volunteer/_activity_history.html.twig') }}
{% endblock %}

{# A staff name; linked for admins only, since /users is theirs alone. #}
{% macro name(user) -%}
    {%- if is_granted('ROLE_ADMIN') -%}
        <a href="{{ path('user_show', {id: user.id}) }}" class="hover:underline">{{ user.fullName }}</a>
    {%- else -%}
        {{ user.fullName }}
    {%- endif -%}
{%- endmacro %}
