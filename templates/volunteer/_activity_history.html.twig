{# The read-only timeline, on the volunteer page and the stay page: `activities`, `activityCount`, `volunteer`, `today`. #}
<div class="rounded-lg border border-slate-200 bg-white p-4">
    {#
        The timeline below is read-only. The link goes to the same
        activities in the Activities index, where they can be edited,
        deleted and paged — same idiom as the Notes section's Edit link.
    #}
    <div class="mb-3 flex items-center justify-between">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500"><span aria-hidden="true">🗓️</span> Activity history</h2>
        <a
            href="{{ path('activity_index', {volunteer: volunteer.id}) }}"
            class="text-sm text-brand-600 hover:underline"
        >See in Activities →</a>
    </div>
    <ul class="space-y-4">
        {% for activity in activities %}
            {% set isPlanned = activity.date > today %}
            {% set durationLabel = activity.duration.value == 'other' ? (activity.durationOther ?: activity.duration.label) : activity.duration.label %}
            <li class="relative border-l-2 {{ isPlanned ? 'border-brand-200' : 'border-slate-200' }} pl-4">
                <span
                    class="absolute -left-[7px] top-1 h-3 w-3 rounded-full {{ isPlanned ? 'border-2 border-brand-500 bg-white' : 'bg-brand-500' }}"
                    aria-hidden="true"
                ></span>
                <div class="text-sm font-medium text-slate-800">
                    {{ activity.date|date('D j M Y') }}{% if isPlanned %} · Planned{% endif %}
                </div>
                <div class="text-sm text-slate-600">{{ activity.program.name }} · {{ activity.project.name }} · {{ activity.stay.branch.name }}</div>
                <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-slate-500">
                    <span class="rounded-full bg-slate-100 px-2 py-0.5">{{ activity.activityType.name }}</span>
                    <span>{{ durationLabel }}</span>
                </div>
                {% if activity.notes %}
                    <p class="mt-1 text-sm text-slate-600 italic">"{{ activity.notes }}"</p>
                {% endif %}
            </li>
        {% else %}
            <li class="text-sm text-slate-500">No activities logged yet.</li>
        {% endfor %}
    </ul>
    {% if activities|length > 0 %}
        <p class="mt-4 text-xs text-slate-400">Showing all {{ activityCount }} logged activit{{ activityCount == 1 ? 'y' : 'ies' }}.</p>
    {% endif %}
</div>
