{% extends 'base.html.twig' %}

{% block title %}{{ user_account.fullName }} — UCESCO Volunteer Manager{% endblock %}

{% block body %}
    <a href="{{ path('user_index') }}" class="mb-4 inline-block text-sm text-slate-600 hover:underline">← Back to Users</a>

    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="flex flex-wrap items-center gap-2 text-xl font-semibold">
                {{ user_account.fullName }}
                <twig:Pill :tone="user_account.admin ? 'brand' : 'neutral'">{{ user_account.admin ? 'Admin' : 'Volunteer Manager' }}</twig:Pill>
                {% if not user_account.active %}<twig:Pill>Deactivated</twig:Pill>{% endif %}
            </h1>
            <p class="mt-1 text-sm text-slate-600">{{ user_account.email }}</p>
            <p class="mt-1 text-sm text-slate-500" data-account-dates>
                Account created {{ user_account.createdAt|date('j F Y') }}, last changed {{ user_account.updatedAt|date('j F Y') }}
                · {{ activityCount }} activit{{ activityCount == 1 ? 'y' : 'ies' }} logged in all
            </p>
        </div>
        <a
            href="{{ path('user_edit', {id: user_account.id}) }}"
            class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
        >
            Edit
        </a>
    </div>

    <section aria-labelledby="timeline-heading" data-user-timeline>
        <h2 id="timeline-heading" class="font-semibold">Recent activity</h2>
        <p class="mb-3 mt-0.5 text-xs text-slate-500">
            The newest {{ limit }} things this account did, from sign-ins, the activities it logged and the
            records it added or last edited. Sign-in attempts are kept for 90 days and matched on the current email.
            Only the last person to edit a record is known, deletions are not recorded, and records from before
            4 October 2026 have no author. See <span class="font-mono text-xs">ADR 0043</span>.
        </p>

        <twig:DataTable
            :columns="columns"
            :rows="rows"
            :withActions="false"
            emptyMessage="Nothing recorded for this account yet."
        />
    </section>
{% endblock %}
