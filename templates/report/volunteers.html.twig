{% extends 'base.html.twig' %}

{% block title %}Volunteering Report — UCESCO Volunteer Manager{% endblock %}

{% macro kpi_tile(label, value, sub) %}
    <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm">
        <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">{{ label }}</div>
        <div class="mt-1 text-2xl font-semibold">{{ value }}</div>
        <div class="mt-0.5 text-xs text-slate-500">{{ sub }}</div>
    </div>
{% endmacro %}

{% import _self as report %}

{% block body %}
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-xl font-semibold">Volunteering Report</h1>
        <button
            type="button"
            onclick="window.print()"
            class="rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-brand-500 hover:text-brand-700 print:hidden"
        >
            Print-friendly view
        </button>
    </div>

    {# data-kpi-tiles rather than relying on `main .grid > div`: the tile count
       is asserted in tests, and a bare .grid selector would break the moment a
       shared component grew a grid class. #}
    <div class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-4" data-kpi-tiles>
        {{ report.kpi_tile('Volunteers', metrics.volunteerCount, metrics.presentVolunteerCount ~ ' present · ' ~ metrics.upcomingVolunteerCount ~ ' upcoming · ' ~ metrics.engagedVolunteerCount ~ ' engaged') }}
        {{ report.kpi_tile('Projects', metrics.projectCount, metrics.activeProjectCount ~ ' active') }}
        {{ report.kpi_tile(
            'Activities logged',
            metrics.activityCount,
            metrics.plannedActivityCount > 0 ? 'incl. ' ~ metrics.plannedActivityCount ~ ' planned' : 'all logged'
        ) }}
        {{ report.kpi_tile(
            'Total days contributed',
            metrics.totalDays|number_format(1),
            metrics.hasUncounted
                ? 'all-time · ' ~ metrics.uncountedDurationCount ~ ' not counted'
                : 'all-time'
        ) }}
    </div>

    {% if byVolunteer is not empty %}
        <section class="mb-8 rounded-lg border border-slate-200 bg-white shadow-sm" aria-labelledby="top-volunteers-heading">
            <div class="border-b border-slate-200 px-5 py-4">
                <h2 id="top-volunteers-heading" class="font-semibold">Top volunteers</h2>
                <p class="mt-0.5 text-xs text-slate-500">By total days contributed, all-time</p>
            </div>
            <ul class="divide-y divide-slate-100">
                {% set medals = {
                    1: 'bg-amber-100 text-amber-700',
                    2: 'bg-slate-100 text-slate-600',
                    3: 'bg-orange-100 text-orange-800',
                } %}
                {% for row in byVolunteer|slice(0, 5) %}
                    {# The stat drops to its own line below sm so the name — the
                       whole point of a recognition card — isn't truncated. #}
                    <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-5 py-3">
                        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-bold {{ medals[loop.index]|default('bg-slate-100 text-slate-400') }}"
                              aria-hidden="true">{{ loop.index }}</span>
                        {# The truncation stays on the span, so wrapping the
                           name in a link doesn't change how a long one is cut.
                           An id-less row — the Unknown bucket — is nobody in
                           particular, so it renders as plain text. #}
                        <span class="min-w-0 flex-1 truncate text-sm font-semibold">
                            {%- if row.id -%}
                                <a href="{{ path('volunteer_show', {id: row.id}) }}" class="text-brand-600 hover:underline">{{ row.label }}</a>
                            {%- else -%}
                                {{ row.label }}
                            {%- endif -%}
                        </span>
                        <span class="w-full pl-10 text-xs tabular-nums text-slate-500 sm:w-auto sm:pl-0 sm:text-sm">
                            {{ row.totalDays|number_format(1) }} days · {{ row.count }} {{ row.count == 1 ? 'activity' : 'activities' }}
                        </span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {#
        On screen: one shared table region, the breakdowns behind tabs.
        Tabs are links carrying ?tab=, not role="tab" buttons — the ARIA tabs
        pattern mandates arrow-key handling we would not be shipping, and a
        server-side tab keeps one model for tab and page alike, survives
        bookmarking, and can't be silently lost when a page link is clicked.
        The links deliberately omit `page`, so switching breakdowns starts over
        at page 1 rather than landing on a page the other list may not have.
        data-turbo-action="replace" keeps the reader's scroll position (ADR 0040).
    #}
    <div data-report-panel="screen" class="print:hidden">
        {% set tab_base = 'rounded-md px-3 py-1.5 text-sm font-medium' %}
        {% set tab_on = tab_base ~ ' bg-brand-600 text-white' %}
        {% set tab_off = tab_base ~ ' border border-slate-300 text-slate-700 hover:border-brand-500 hover:text-brand-700' %}
        {% set carried = app.request.query.all|filter((v, k) => k not in ['tab', 'page'] and v is not iterable) %}

        <nav class="mb-3 flex flex-wrap items-center gap-2" aria-label="Report breakdown">
            <a
                href="{{ path('report_volunteers', carried|merge({tab: 'branch'})) }}"
                class="{{ tab == 'branch' ? tab_on : tab_off }}"
                {{ tab == 'branch' ? 'aria-current="page"' : '' }}
                data-turbo-action="replace"
            >By branch</a>
            <a
                href="{{ path('report_volunteers', carried|merge({tab: 'project'})) }}"
                class="{{ tab == 'project' ? tab_on : tab_off }}"
                {{ tab == 'project' ? 'aria-current="page"' : '' }}
                data-turbo-action="replace"
            >By project</a>
            <a
                href="{{ path('report_volunteers', carried|merge({tab: 'program'})) }}"
                class="{{ tab == 'program' ? tab_on : tab_off }}"
                {{ tab == 'program' ? 'aria-current="page"' : '' }}
                data-turbo-action="replace"
            >By program</a>
            <a
                href="{{ path('report_volunteers', carried|merge({tab: 'type'})) }}"
                class="{{ tab == 'type' ? tab_on : tab_off }}"
                {{ tab == 'type' ? 'aria-current="page"' : '' }}
                data-turbo-action="replace"
            >By activity type</a>
            <a
                href="{{ path('report_volunteers', carried|merge({tab: 'group'})) }}"
                class="{{ tab == 'group' ? tab_on : tab_off }}"
                {{ tab == 'group' ? 'aria-current="page"' : '' }}
                data-turbo-action="replace"
            >By beneficiary group</a>
            <a
                href="{{ path('report_volunteers', carried|merge({tab: 'volunteer'})) }}"
                class="{{ tab == 'volunteer' ? tab_on : tab_off }}"
                {{ tab == 'volunteer' ? 'aria-current="page"' : '' }}
                data-turbo-action="replace"
            >By volunteer</a>
            <a
                href="{{ path('report_volunteers', carried|merge({tab: 'source'})) }}"
                class="{{ tab == 'source' ? tab_on : tab_off }}"
                {{ tab == 'source' ? 'aria-current="page"' : '' }}
                data-turbo-action="replace"
            >By source</a>
            <a
                href="{{ path('report_volunteers', carried|merge({tab: 'escort'})) }}"
                class="{{ tab == 'escort' ? tab_on : tab_off }}"
                {{ tab == 'escort' ? 'aria-current="page"' : '' }}
                data-turbo-action="replace"
            >By escort</a>
            <a
                href="{{ path('report_volunteers', carried|merge({tab: 'month'})) }}"
                class="{{ tab == 'month' ? tab_on : tab_off }}"
                {{ tab == 'month' ? 'aria-current="page"' : '' }}
                data-turbo-action="replace"
            >By period</a>
        </nav>

        {% if tab == 'group' %}
            <p class="mb-2 text-xs text-slate-500">A program serving several groups counts in full under each, so the totals add up to more than the real days.</p>
        {% endif %}
        {% if tab == 'source' %}
            {# The only per-year tab (ADR 0041). A new year starts the list over at page 1. #}
            <form method="get" data-turbo-action="replace" data-controller="auto-submit" class="mb-2 flex items-center gap-2 text-sm text-slate-600">
                {% for key, value in app.request.query.all %}
                    {% if key not in ['page', 'year'] and value is not iterable %}
                        <input type="hidden" name="{{ key }}" value="{{ value }}">
                    {% endif %}
                {% endfor %}
                <label for="report-year">Year</label>
                <select
                    id="report-year"
                    name="year"
                    class="rounded-md border border-slate-300 px-2 py-1 text-sm focus:border-brand-500 focus:outline-none"
                    data-action="change->auto-submit#submit"
                >
                    {% for option in yearOptions %}
                        <option value="{{ option }}" {{ option == year ? 'selected' : '' }}>{{ option }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="sr-only">Show</button>
            </form>
            <p class="mb-2 text-xs text-slate-500" data-source-note>Counts {{ year }}'s activities. A volunteer with several sources counts in full under each, so the totals add up to more than the real figures.</p>
        {% endif %}

        {% if tab == 'month' %}
            {# Same shape as the source tab's year form. #}
            <form method="get" data-turbo-action="replace" data-controller="auto-submit" class="mb-2 flex items-center gap-2 text-sm text-slate-600">
                {% for key, value in app.request.query.all %}
                    {% if key not in ['page', 'branch', 'step'] and value is not iterable %}
                        <input type="hidden" name="{{ key }}" value="{{ value }}">
                    {% endif %}
                {% endfor %}
                <label for="report-branch" class="sr-only">Branch</label>
                <select
                    id="report-branch"
                    name="branch"
                    class="rounded-md border border-slate-300 px-2 py-1 text-sm focus:border-brand-500 focus:outline-none"
                    data-action="change->auto-submit#submit"
                >
                    <option value="">Every branch</option>
                    {% for option in branchOptions %}
                        <option value="{{ option.id }}" {{ branch and branch.id == option.id ? 'selected' : '' }}>{{ option.name }}</option>
                    {% endfor %}
                </select>
                <label for="report-step" class="sr-only">Period</label>
                <select
                    id="report-step"
                    name="step"
                    class="rounded-md border border-slate-300 px-2 py-1 text-sm focus:border-brand-500 focus:outline-none"
                    data-action="change->auto-submit#submit"
                >
                    {% for option in stepOptions %}
                        <option value="{{ option.value }}" {{ step is same as(option) ? 'selected' : '' }}>By {{ option.value }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="sr-only">Show</button>
            </form>
            <p class="mb-2 text-xs text-slate-500" data-period-note>Each total counts a volunteer once per {{ step.value }}. Present: a stay overlaps the {{ step.value }}. New arrivals: a stay starts in it. Engaged: an activity is dated in it. "±" compares with the {{ step.value }} before{{ step.value == 'month' ? ' and the same month last year' }}.</p>
        {% endif %}

        <twig:DataTable
            :columns="columns"
            :rows="rows"
            :pagination="pagination"
            :sortState="sortState"
            :withActions="false"
            emptyMessage="No activities logged yet."
        />
        <p class="mt-2 text-xs text-slate-500" data-report-note>Every column includes planned activities. "Volunteers engaged" counts each person once per row.</p>
    </div>

    {#
        On paper: every breakdown, complete and unpaginated. The print-friendly
        view shipped before the tabs did, and it has always handed over every
        row of every table — tabbing the screen must not quietly halve what
        prints. Costs no extra query; every summary is already in hand.
    #}
    <div data-report-panel="print" class="hidden print:block">
        <p class="mb-4 text-xs text-slate-500">Every column includes planned activities. "Volunteers engaged" counts each person once per row.</p>
        <div>
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">By branch</h2>
            <twig:DataTable
                :columns="branchColumns"
                :rows="branchRows"
                :withActions="false"
                emptyMessage="No activities logged yet."
            />
        </div>

        <div class="mt-8">
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">By project</h2>
            <twig:DataTable
                :columns="projectColumns"
                :rows="projectRows"
                :withActions="false"
                emptyMessage="No activities logged yet."
            />
        </div>

        <div class="mt-8">
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">By program</h2>
            <twig:DataTable
                :columns="programColumns"
                :rows="programRows"
                :withActions="false"
                emptyMessage="No activities logged yet."
            />
            {% if beneficiaries is not empty %}
                <h3 class="mb-1 mt-4 text-xs font-semibold uppercase tracking-wide text-slate-500">Beneficiaries reached</h3>
                <dl class="space-y-1 text-sm" data-report-beneficiaries>
                    {% for program in beneficiaries %}
                        <div>
                            <dt class="inline font-medium">{{ program.project.name }} — {{ program.name }}:</dt>
                            <dd class="inline whitespace-pre-line text-slate-700">{{ program.beneficiariesReached }}</dd>
                        </div>
                    {% endfor %}
                </dl>
            {% endif %}
        </div>

        <div class="mt-8">
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">By activity type</h2>
            <twig:DataTable
                :columns="activityTypeColumns"
                :rows="activityTypeRows"
                :withActions="false"
                emptyMessage="No activities logged yet."
            />
        </div>

        <div class="mt-8">
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">By beneficiary group</h2>
            <p class="mb-2 text-xs text-slate-500">A program serving several groups counts in full under each.</p>
            <twig:DataTable
                :columns="groupColumns"
                :rows="groupRows"
                :withActions="false"
                emptyMessage="No activities logged yet."
            />
        </div>

        <div class="mt-8">
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">By volunteer</h2>
            <twig:DataTable
                :columns="volunteerColumns"
                :rows="volunteerRows"
                :withActions="false"
                emptyMessage="No activities logged yet."
            />
        </div>

        <div class="mt-8">
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">By source</h2>
            <p class="mb-2 text-xs text-slate-500">{{ year }}'s activities only. A volunteer with several sources counts in full under each.</p>
            <twig:DataTable
                :columns="sourceColumns"
                :rows="sourceRows"
                :withActions="false"
                emptyMessage="No sources yet."
            />
        </div>

        <div class="mt-8">
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">By escort</h2>
            <twig:DataTable
                :columns="escortColumns"
                :rows="escortRows"
                :withActions="false"
                emptyMessage="No activities logged yet."
            />
        </div>

        <div class="mt-8">
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">By period</h2>
            <p class="mb-2 text-xs text-slate-500">{{ branch ? branch.name : 'Every branch' }}, by {{ step.value }}. Each total counts a volunteer once per {{ step.value }}: present, a stay overlaps it; new arrivals, a stay starts in it; engaged, an activity is dated in it.</p>
            <twig:DataTable
                :columns="periodColumns"
                :rows="periodRows"
                :withActions="false"
                emptyMessage="No stays recorded yet."
            />
        </div>
    </div>
{% endblock %}
