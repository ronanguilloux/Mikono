{% extends 'base.html.twig' %}

{% block title %}Reports — UCESCO Volunteer Manager{% endblock %}

{% macro kpi_tile(label, value, sub) %}
    <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm">
        <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">{{ label }}</div>
        <div class="mt-1 text-2xl font-semibold">{{ value }}</div>
        <div class="mt-0.5 text-xs text-slate-500">{{ sub }}</div>
    </div>
{% endmacro %}

{% import _self as report %}

{% block body %}
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-xl font-semibold">Reports</h1>
        <button
            type="button"
            onclick="window.print()"
            class="rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-brand-500 hover:text-brand-700 print:hidden"
        >
            Print-friendly view
        </button>
    </div>

    {# data-kpi-tiles rather than relying on `main .grid > div`: the tile count
       is asserted in tests, and a bare .grid selector would break the moment a
       shared component grew a grid class. #}
    <div class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-4" data-kpi-tiles>
        {{ report.kpi_tile('Volunteers', metrics.volunteerCount, metrics.activeVolunteerCount ~ ' active') }}
        {{ report.kpi_tile('Projects', metrics.projectCount, metrics.activeProjectCount ~ ' active') }}
        {{ report.kpi_tile(
            'Activities logged',
            metrics.activityCount,
            metrics.plannedActivityCount > 0 ? 'incl. ' ~ metrics.plannedActivityCount ~ ' planned' : 'all logged'
        ) }}
        {{ report.kpi_tile(
            'Total days contributed',
            metrics.totalDays|number_format(1),
            metrics.hasUncounted
                ? 'all-time · ' ~ metrics.uncountedDurationCount ~ ' not counted'
                : 'all-time'
        ) }}
    </div>

    {% if byVolunteer is not empty %}
        <section class="mb-8 rounded-lg border border-slate-200 bg-white shadow-sm" aria-labelledby="top-volunteers-heading">
            <div class="border-b border-slate-200 px-5 py-4">
                <h2 id="top-volunteers-heading" class="font-semibold">Top volunteers</h2>
                <p class="mt-0.5 text-xs text-slate-500">By total days contributed, all-time</p>
            </div>
            <ul class="divide-y divide-slate-100">
                {% set medals = {
                    1: 'bg-amber-100 text-amber-700',
                    2: 'bg-slate-100 text-slate-600',
                    3: 'bg-orange-100 text-orange-800',
                } %}
                {% for row in byVolunteer|slice(0, 5) %}
                    {# The stat drops to its own line below sm so the name — the
                       whole point of a recognition card — isn't truncated. #}
                    <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-5 py-3">
                        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-bold {{ medals[loop.index]|default('bg-slate-100 text-slate-400') }}"
                              aria-hidden="true">{{ loop.index }}</span>
                        <span class="min-w-0 flex-1 truncate text-sm font-semibold">{{ row.label }}</span>
                        <span class="w-full pl-10 text-xs tabular-nums text-slate-500 sm:w-auto sm:pl-0 sm:text-sm">
                            {{ row.totalDays|number_format(1) }} days · {{ row.count }} {{ row.count == 1 ? 'activity' : 'activities' }}
                        </span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {#
        On screen: one shared table region, the two breakdowns behind tabs.
        Tabs are links carrying ?tab=, not role="tab" buttons — the ARIA tabs
        pattern mandates arrow-key handling we would not be shipping, and a
        server-side tab keeps one model for tab and page alike, survives
        bookmarking, and can't be silently lost when a page link is clicked.
        The links deliberately omit `page`, so switching breakdowns starts over
        at page 1 rather than landing on a page the other list may not have.
    #}
    <div data-report-panel="screen" class="print:hidden">
        {% set tab_base = 'rounded-md px-3 py-1.5 text-sm font-medium' %}
        {% set tab_on = tab_base ~ ' bg-brand-600 text-white' %}
        {% set tab_off = tab_base ~ ' border border-slate-300 text-slate-700 hover:border-brand-500 hover:text-brand-700' %}
        {% set carried = app.request.query.all|filter((v, k) => k not in ['tab', 'page'] and v is not iterable) %}

        <nav class="mb-3 flex flex-wrap items-center gap-2" aria-label="Report breakdown">
            <a
                href="{{ path('report_index', carried|merge({tab: 'volunteer'})) }}"
                class="{{ tab == 'volunteer' ? tab_on : tab_off }}"
                {{ tab == 'volunteer' ? 'aria-current="page"' : '' }}
            >By volunteer</a>
            <a
                href="{{ path('report_index', carried|merge({tab: 'project'})) }}"
                class="{{ tab == 'project' ? tab_on : tab_off }}"
                {{ tab == 'project' ? 'aria-current="page"' : '' }}
            >By project</a>
        </nav>

        <twig:DataTable
            :columns="columns"
            :rows="rows"
            :pagination="pagination"
            :sortState="sortState"
            :withActions="false"
            emptyMessage="No activities logged yet."
        />
    </div>

    {#
        On paper: both breakdowns, complete and unpaginated. The print-friendly
        view shipped before the tabs did, and it has always handed over every
        row of both tables — tabbing the screen must not quietly halve what
        prints. Costs no extra query; both summaries are already in hand.
    #}
    <div data-report-panel="print" class="hidden print:block">
        <div class="mb-8">
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">By volunteer</h2>
            <twig:DataTable
                :columns="volunteerColumns"
                :rows="volunteerRows"
                :withActions="false"
                emptyMessage="No activities logged yet."
            />
        </div>

        <div>
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">By project</h2>
            <twig:DataTable
                :columns="projectColumns"
                :rows="projectRows"
                :withActions="false"
                emptyMessage="No activities logged yet."
            />
        </div>
    </div>
{% endblock %}
