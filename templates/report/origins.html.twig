{% extends 'base.html.twig' %}

{% block title %}Volunteers' Origins — UCESCO Volunteer Manager{% endblock %}

{% macro legend(legend, noVolunteersFill) %}
    <ul class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-600" aria-hidden="true">
        <li class="flex items-center gap-1.5"><span class="size-3 rounded-sm" style="background: {{ noVolunteersFill }}"></span>None</li>
        {% for bin in legend %}
            <li class="flex items-center gap-1.5"><span class="size-3 rounded-sm" style="background: {{ bin.fill }}"></span>{{ bin.label }}</li>
        {% endfor %}
        <li class="text-slate-500">volunteers</li>
    </ul>
{% endmacro %}

{% import _self as origins %}

{% block body %}
    <div class="mb-2 flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-xl font-semibold">Volunteers' Origins</h1>
        <twig:ExportMenu route="report_origins_export" />
    </div>
    <p class="mb-6 text-sm text-slate-600" data-origins-summary>
        {{ total|number_format }} volunteers on file, from {{ countryCount }} {{ countryCount == 1 ? 'country' : 'countries' }} of residence{% if total > recorded %} · {{ (total - recorded)|number_format }} with none recorded{% endif %}.
    </p>

    <figure class="mb-6 rounded-lg border border-slate-200 bg-white p-4 shadow-sm break-inside-avoid" data-map>
        <figcaption class="mb-3 font-medium text-slate-800">Where they live <span class="text-sm font-normal text-slate-500">· hover a country for its count, drag to pan, +/− to zoom</span></figcaption>
        {# The map's own proportions (900 × 441), full width: the map is
           aria-hidden, and the chart below carries every number in text. #}
        <div
            class="aspect-[900/441] w-full"
            aria-hidden="true"
            data-controller="world-map"
            data-world-map-fills-value="{{ fills|json_encode }}"
            data-world-map-titles-value="{{ titles|json_encode }}"
            data-world-map-no-volunteers-value="{{ noVolunteersFill }}"
        ></div>
        {{ origins.legend(legend, noVolunteersFill) }}
    </figure>

    {% if tooSmall is not empty %}
        <p class="-mt-3 mb-6 text-sm text-slate-600" data-too-small>
            Too small to draw on the map: {{ tooSmall|map(c => c.country ~ ' ' ~ c.volunteers)|join(', ') }}.
        </p>
    {% endif %}

    {% if bars is not empty %}
        <twig:BarChart
            title="Volunteers per country of residence"
            summary="{{ countryCount }} {{ countryCount == 1 ? 'country' : 'countries' }} · % of the {{ recorded|number_format }} with a country recorded"
            :rows="bars"
            class="mb-6 break-inside-avoid"
        />
    {% endif %}
{% endblock %}
